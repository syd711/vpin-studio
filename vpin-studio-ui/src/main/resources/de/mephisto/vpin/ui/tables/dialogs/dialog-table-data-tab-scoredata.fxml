<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxWidth="1.7976931348623157E308" styleClass="sm-transparent-scroll" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.tables.dialogs.TableDataTabScoreDataController">
   <content>
      <VBox fx:id="root" maxWidth="1.7976931348623157E308" spacing="14.0">
         <padding>
            <Insets bottom="14.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <!-- tile: score data -->
            <VBox maxWidth="1.7976931348623157E308" spacing="12.0" styleClass="sm-tile">
               <children>
                  <HBox spacing="12.0">
                     <children>
                        <VBox maxWidth="1.7976931348623157E308" minWidth="0.0" spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="sm-title" text="%tables.table_data_tab_scoredata.score_data" />
                              <Label styleClass="sm-hint" text="%tables.table_data_tab_scoredata.the_given_fields_are_used_to_read_the" wrapText="true" />
                           </children>
                        </VBox>
                        <Button minWidth="-Infinity" fx:id="resetBtn" mnemonicParsing="false" onAction="#onScoreReset" styleClass="sm-danger-button" text="%tables.table_data_tab_scoredata.reset_highscore">
                           <graphic>
                              <FontIcon iconLiteral="mdi2r-reload-alert" iconSize="18" styleClass="c-icon-danger" />
                           </graphic>
                           <tooltip>
                              <Tooltip text="%tables.table_data_tab_scoredata.reset_highscores" />
                           </tooltip>
                        </Button>
                     </children>
                  </HBox>
                  <GridPane hgap="8.0" vgap="8.0">
                     <columnConstraints>
                        <ColumnConstraints maxWidth="200.0" minWidth="200.0" prefWidth="200.0" />
                        <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                        <ColumnConstraints maxWidth="180.0" minWidth="180.0" prefWidth="180.0" />
                     </columnConstraints>
                     <children>
                        <!-- row 0: ROM Name -->
                        <Label styleClass="sm-text" text="%backups.backups_sidebar.rom_name" />
                        <ComboBox fx:id="romName" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" />
                        <HBox fx:id="romStatusBox" alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="2" />
                        <!-- row 1: Alternative ROM Name -->
                        <Label styleClass="sm-text" text="%tables.table_data_tab_scoredata.alternative_rom_name" GridPane.rowIndex="1" />
                        <TextField fx:id="altRomName" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <!-- row 2: Highscore .txt File Name -->
                        <Label styleClass="sm-text" text="%tables.table_data_tab_scoredata.highscore_txt_file_name" GridPane.rowIndex="2" />
                        <ComboBox fx:id="highscoreFileName" editable="true" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <HBox fx:id="hsFileStatusBox" alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <!-- row 3: mapping hint -->
                        <Label fx:id="hsMappingLabel" styleClass="sm-small" text="%tables.table_data_tab_scoredata.the_value_is_mapped_to_popper_field" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     </children>
                  </GridPane>
               </children>
               <padding>
                  <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
               </padding>
            </VBox>
            <!-- tile: scanned values -->
            <VBox maxWidth="1.7976931348623157E308" spacing="12.0" styleClass="sm-tile">
               <children>
                  <HBox spacing="12.0">
                     <children>
                        <VBox maxWidth="1.7976931348623157E308" minWidth="0.0" spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="sm-title" text="%tables.table_data_tab_scoredata.scanned_values" />
                              <Label styleClass="sm-hint" text="%tables.table_data_tab_scoredata.this_section_shows_several_values_extracted_from_the" wrapText="true" />
                              <Label styleClass="sm-hint" text="%tables.table_data_tab_scoredata.the_values_are_used_as_fallback_for_the" wrapText="true" />
                              <Label styleClass="sm-hint" text="%tables.table_data_tab_scoredata.click_apply_to_save_them_to_the_pinup" wrapText="true" />
                           </children>
                        </VBox>
                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#onTableScan" styleClass="sm-button" text="%tables.table_data_tab_scoredata.scan_table">
                           <graphic>
                              <FontIcon iconLiteral="mdi2m-map-search-outline" iconSize="18" styleClass="c-icon-white" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
                  <GridPane hgap="8.0" vgap="8.0">
                     <columnConstraints>
                        <ColumnConstraints maxWidth="200.0" minWidth="200.0" prefWidth="200.0" />
                        <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                        <ColumnConstraints maxWidth="180.0" minWidth="180.0" prefWidth="180.0" />
                     </columnConstraints>
                     <children>
                        <!-- row 0: Scanned ROM Name -->
                        <Label styleClass="sm-text" text="%tables.table_data_tab_scoredata.scanned_rom_name" />
                        <TextField fx:id="scannedRomName" editable="false" GridPane.columnIndex="1" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="2">
                           <children>
                              <Button fx:id="applyRomBtn" mnemonicParsing="false" onAction="#onRomApply" styleClass="sm-button" text="%tables.table_data_tab_scoredata.apply">
                                 <tooltip>
                                    <Tooltip prefWidth="300.0" text="%tables.table_data_tab_scoredata.apply_scanned_rom_name_to_popper_field_rom" wrapText="true" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                        <!-- row 1: Scanned Alt. ROM Name -->
                        <Label styleClass="sm-text" text="%tables.table_data_tab_scoredata.scanned_alt_rom_name" GridPane.rowIndex="1" />
                        <TextField fx:id="scannedAltRomName" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                           <children>
                              <Button fx:id="applyAltRomBtn" mnemonicParsing="false" onAction="#onAltRomApply" styleClass="sm-button" text="%tables.table_data_tab_scoredata.apply">
                                 <tooltip>
                                    <Tooltip prefWidth="300.0" text="%tables.table_data_tab_scoredata.apply_scanned_alternative_rom_name_to_popper_field" wrapText="true" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                        <!-- row 2: Scanned Score .txt File Name -->
                        <Label styleClass="sm-text" text="%tables.table_data_tab_scoredata.scanned_score_txt_file_name" GridPane.rowIndex="2" />
                        <TextField fx:id="scannedHighscoreFileName" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="2" GridPane.rowIndex="2">
                           <children>
                              <Button fx:id="applyHsBtn" mnemonicParsing="false" onAction="#onHsApply" styleClass="sm-button" text="%tables.table_data_tab_scoredata.apply">
                                 <tooltip>
                                    <Tooltip prefWidth="300.0" text="%tables.table_data_tab_scoredata.apply_scanned_highscore_file_name_to_popper_to" wrapText="true" />
                                 </tooltip>
                              </Button>
                              <Button fx:id="openHsFileBtn" mnemonicParsing="false" onAction="#onEMHighscore" styleClass="sm-button, sm-button-icon, folder-component">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2f-folder-open" iconSize="16" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%tables.table_data_tab_scoredata.open_the_tables_folder_of_vpx" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                        <!-- row 3: hints -->
                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                           <children>
                              <Label styleClass="sm-small" text="%tables.table_data_tab_scoredata.used_by_tables_that_store_highscores_in_txt" wrapText="true" />
                              <Label styleClass="sm-small" text="%tables.table_data_tab_scoredata.the_alt_rom_name_is_used_as_additional" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </GridPane>
               </children>
               <padding>
                  <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
