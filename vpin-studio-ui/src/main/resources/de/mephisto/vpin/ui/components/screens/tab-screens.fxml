<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.components.screens.ScreensController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <top>
      <!-- validation errors -->
      <HBox fx:id="errorBox" alignment="CENTER_LEFT" spacing="12.0" styleClass="sm-alert" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="14.0" />
         </BorderPane.margin>
         <children>
            <StackPane maxHeight="26.0" maxWidth="26.0" minHeight="26.0" minWidth="26.0" styleClass="sm-alert-icon">
               <children>
                  <FontIcon styleClass="c-icon-white" iconLiteral="mdi2e-exclamation-thick" iconSize="16" />
               </children>
            </StackPane>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="sm-alert-title" text="%components.screens.errors_title" />
                  <VBox fx:id="errorList" spacing="2.0" />
               </children>
            </VBox>
         </children>
      </HBox>
   </top>
   <center>
      <HBox spacing="14.0" BorderPane.alignment="CENTER">
         <children>
            <!-- screen list -->
            <VBox maxWidth="290.0" minWidth="290.0" prefWidth="290.0" styleClass="sm-panel">
               <children>
                  <HBox alignment="BASELINE_LEFT" spacing="8.0" styleClass="sm-divider">
                     <padding>
                        <Insets bottom="10.0" left="14.0" right="14.0" top="14.0" />
                     </padding>
                     <children>
                        <Label styleClass="sm-title" text="%components.components.screens" />
                        <Label fx:id="countLabel" styleClass="sm-small" />
                     </children>
                  </HBox>
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sm-transparent-scroll" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="groupsBox" spacing="8.0">
                           <padding>
                              <Insets bottom="12.0" top="6.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <!-- monitor map -->
            <VBox styleClass="sm-panel" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sm-divider">
                     <padding>
                        <Insets bottom="8.0" left="10.0" right="12.0" top="8.0" />
                     </padding>
                     <children>
                        <Button mnemonicParsing="false" onAction="#onReload" styleClass="sm-button, sm-button-icon">
                           <graphic>
                              <FontIcon styleClass="c-icon-white" iconLiteral="mdi2r-reload" iconSize="18" />
                           </graphic>
                           <tooltip>
                              <Tooltip text="%components.emulators.emulator_script.reload_screen_settings" />
                           </tooltip>
                        </Button>
                        <Region minWidth="1.0" prefHeight="20.0" prefWidth="1.0" style="-fx-background-color: -c-border;" />
                        <Button fx:id="zoomOutBtn" mnemonicParsing="false" onAction="#onZoomOut" styleClass="sm-button, sm-button-icon">
                           <graphic>
                              <FontIcon styleClass="c-icon-white" iconLiteral="mdi2m-minus" iconSize="18" />
                           </graphic>
                        </Button>
                        <Label fx:id="zoomLabel" alignment="CENTER" minWidth="52.0" styleClass="sm-text" text="100%" />
                        <Button fx:id="zoomInBtn" mnemonicParsing="false" onAction="#onZoomIn" styleClass="sm-button, sm-button-icon">
                           <graphic>
                              <FontIcon styleClass="c-icon-white" iconLiteral="mdi2p-plus" iconSize="18" />
                           </graphic>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onZoomFit" styleClass="sm-button" text="%components.screens.fit" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="legendBox" alignment="CENTER_LEFT" spacing="14.0" />
                     </children>
                  </HBox>
                  <ScrollPane fx:id="mapScroll" styleClass="sm-map" VBox.vgrow="ALWAYS">
                     <content>
                        <Pane fx:id="canvas" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <!-- inspector -->
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxWidth="270.0" minWidth="270.0" prefWidth="270.0" styleClass="sm-transparent-scroll">
               <content>
                  <VBox fx:id="inspector" spacing="16.0" styleClass="sm-panel">
                     <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </HBox>
   </center>
</BorderPane>
