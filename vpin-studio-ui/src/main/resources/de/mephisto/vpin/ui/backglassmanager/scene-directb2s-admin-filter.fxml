<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- filter panel: see UI-STYLEGUIDE.md "Filter panel" -->
<VBox fx:id="filterRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="200.0" minWidth="-Infinity" prefWidth="286.0" styleClass="sm-panel" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.backglassmanager.BackglassManagerFilterController">
   <children>
      <!-- header -->
      <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sm-divider">
         <children>
            <Label maxWidth="1.7976931348623157E308" styleClass="sm-caption" text="%common.filter" HBox.hgrow="ALWAYS" />
            <Button fx:id="resetBtn" mnemonicParsing="false" onAction="#onReset" styleClass="sm-button, sm-button-small" text="%backglass.directb2s_admin_filter.reset_all" />
            <Button mnemonicParsing="false" onAction="#toggle" styleClass="sm-button, sm-button-small">
               <graphic>
                  <FontIcon iconLiteral="mdi2a-arrow-expand-left" iconSize="14" styleClass="c-icon-white" />
               </graphic>
               <tooltip>
                  <Tooltip text="%backglass.directb2s_admin.toggle_filter_view" />
               </tooltip>
            </Button>
         </children>
         <padding>
            <Insets bottom="10.0" left="16.0" right="10.0" top="10.0" />
         </padding>
      </HBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sm-transparent-scroll" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="22.0">
               <children>
                  <!-- emulators: check boxes built in BackglassManagerFilterController -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%backglass.directb2s_admin_filter.emulator_filters" />
                        <VBox fx:id="emulatorFilters" spacing="8.0" />
                     </children>
                  </VBox>

                  <!-- backglass -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%backglass.directb2s_admin_filter.backglass_filters" />
                        <VBox fx:id="backglassFilters" spacing="8.0">
                           <children>
                              <CheckBox fx:id="missingDMDImageCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%backglass.directb2s_admin_filter.missing_dmd_image" wrapText="true" />
                              <CheckBox fx:id="notFullDMDRatioCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%backglass.directb2s_admin_filter.dmd_aspect_ratio_not_full_dmd" wrapText="true" />
                              <CheckBox fx:id="scoresAvailableCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%backglass.directb2s_admin_filter.presence_of_score_element" wrapText="true" />
                              <CheckBox fx:id="missingTableCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%backglass.directb2s_admin_filter.backglass_without_table" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- settings -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%backglass.directb2s_admin_filter.settings_filters" />
                        <VBox fx:id="settingFilters" spacing="8.0">
                           <children>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="sm-small" text="%backglass.directb2s_admin_filter.grill_visibility" />
                                    <ComboBox fx:id="grillVisibilityComboBox" maxWidth="1.7976931348623157E308" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="sm-small" text="%backglass.directb2s_admin_filter.dmd_visibility" />
                                    <ComboBox fx:id="dmdVisibilityComboBox" maxWidth="1.7976931348623157E308" />
                                 </children>
                              </VBox>
                              <CheckBox fx:id="backglassVisibilityCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%backglass.directb2s_admin_filter.backglass_hidden" wrapText="true" />
                              <CheckBox fx:id="b2sdmdVisibilityCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%backglass.directb2s_admin_filter.b2s_dmd_hidden" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="18.0" left="16.0" right="16.0" top="16.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
