<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="root" prefWidth="600.0" VBox.vgrow="ALWAYS" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.vps.VpsTablesSidebarController">
   <children>
      <!-- header -->
      <HBox spacing="8.0" styleClass="sm-divider">
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="sm-caption" text="%vps.vps_tables_sidebar.caption_details" />
                  <Label fx:id="nameLabel" styleClass="vps-sidebar-title" text="-" wrapText="true" />
                  <Label fx:id="subtitleLabel" styleClass="sm-hint" text="-" wrapText="true" />
               </children>
            </VBox>
            <Button fx:id="openBtn" mnemonicParsing="false" onAction="#onVpsBtn" styleClass="sm-button, sm-button-icon, link-component">
               <graphic>
                  <FontIcon iconLiteral="mdi2o-open-in-new" iconSize="18" styleClass="c-icon-white" />
               </graphic>
               <tooltip>
                  <Tooltip text="%vps.vps_tables_sidebar.open_table_on_https_virtual_pinball_spreadsheet_web" />
               </tooltip>
            </Button>
            <Button fx:id="copyBtn" mnemonicParsing="false" onAction="#onCopyVpsLink" styleClass="sm-button, sm-button-icon">
               <graphic>
                  <FontIcon iconLiteral="mdi2c-content-copy" iconSize="18" styleClass="c-icon-white" />
               </graphic>
               <tooltip>
                  <Tooltip text="%vps.vps_tables_sidebar.copy_vps_link" />
               </tooltip>
            </Button>
         </children>
         <padding>
            <Insets bottom="14.0" left="18.0" right="18.0" top="16.0" />
         </padding>
      </HBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sm-transparent-scroll" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="detailsBox" spacing="22.0">
               <children>
                  <!-- features + facts -->
                  <VBox spacing="12.0">
                     <children>
                        <FlowPane fx:id="features" hgap="6.0" vgap="6.0" />
                        <GridPane fx:id="factsGrid" styleClass="sm-inset, vps-facts">
                           <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                           </columnConstraints>
                           <children>
                              <VBox spacing="4.0" styleClass="vps-fact, vps-fact-left">
                                 <children>
                                    <Label styleClass="sm-caption" text="%vps.vps_tables_sidebar.manufacturer" />
                                    <Label fx:id="manufacturer" styleClass="sm-text, vps-fact-value" text="-" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" styleClass="vps-fact" GridPane.columnIndex="1">
                                 <children>
                                    <Label styleClass="sm-caption" text="%vps.vps_tables_sidebar.year" />
                                    <Label fx:id="year" styleClass="sm-text, vps-fact-value" text="-" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" styleClass="vps-fact, vps-fact-left" GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="sm-caption" text="%vps.vps_tables_sidebar.type" />
                                    <Label fx:id="typeLabel" styleClass="sm-text, vps-fact-value" text="-" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" styleClass="vps-fact" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="sm-caption" text="%vps.vps_tables_sidebar.players" />
                                    <Label fx:id="players" styleClass="sm-text, vps-fact-value" text="-" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" styleClass="vps-fact" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                 <children>
                                    <Label styleClass="sm-caption" text="%vps.vps_tables_sidebar.theme_caption" />
                                    <Label fx:id="theme" styleClass="sm-text, vps-fact-value" text="-" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" styleClass="vps-fact, vps-fact-left, vps-fact-last" GridPane.rowIndex="3">
                                 <children>
                                    <Label styleClass="sm-caption" text="%vps.vps_tables_sidebar.updated" />
                                    <Label fx:id="updated" styleClass="sm-text, vps-fact-value" text="-" />
                                 </children>
                              </VBox>
                              <Pane styleClass="vps-fact, vps-fact-last" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                           </children>
                        </GridPane>

                        <!-- IPDB link -->
                        <HBox fx:id="ipdbBox" alignment="CENTER_LEFT" spacing="10.0" styleClass="sm-inset">
                           <children>
                              <Label styleClass="vps-tag" text="IPDB" />
                              <Hyperlink fx:id="ipdbLink" onAction="#onIpdbLink" styleClass="sm-link" text="-" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                              <Button fx:id="ipdbBtn" mnemonicParsing="false" onAction="#onIpdbLink" styleClass="sm-section-header">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2o-open-in-new" iconSize="16" styleClass="c-icon-link" />
                                 </graphic>
                              </Button>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                           </padding>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- personal comment -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%vps.vps_tables_sidebar.personal_comment_caption" />
                        <TextArea fx:id="commentsArea" minHeight="100.0" prefHeight="100.0" promptText="%vps.vps_tables_sidebar.comment_prompt" wrapText="true" />
                     </children>
                  </VBox>

                  <!-- downloads -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%vps.vps_tables_sidebar.downloads" />
                        <VBox fx:id="dataRoot" spacing="12.0" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="18.0" left="18.0" right="18.0" top="16.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
