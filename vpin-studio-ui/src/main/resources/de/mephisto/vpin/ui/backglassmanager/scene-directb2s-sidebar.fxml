<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitMenuButton?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="sm-panel" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.backglassmanager.BackglassManagerSidebarController">
   <children>
      <!-- header: name, version selector, activation and file actions -->
      <HBox spacing="8.0" styleClass="sm-divider">
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="sm-caption" text="%backglass.sidebar.caption" />
                  <Label fx:id="titleLabel" styleClass="vps-sidebar-title" text="-" wrapText="true" />
                  <Label fx:id="directB2SLabel" styleClass="sm-hint" text="-" />
                  <ComboBox fx:id="directB2SCombo" maxWidth="1.7976931348623157E308" />
               </children>
            </VBox>
            <HBox alignment="TOP_RIGHT" spacing="8.0">
               <children>
                  <CheckBox fx:id="activateCheckbox" maxHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" styleClass="sm-text, sm-header-checkbox, sm-accent-checkbox" text="%backglass.sidebar.active">
                     <tooltip>
                        <Tooltip text="%backglass.directb2s_sidebar.active_backglass" />
                     </tooltip>
                  </CheckBox>
                  <Button fx:id="openBtn" mnemonicParsing="false" onAction="#onOpen" styleClass="sm-button, sm-button-icon, folder-component">
                     <graphic>
                        <FontIcon iconLiteral="mdi2f-folder-open" iconSize="18" styleClass="c-icon-white" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%backglass.sidebar.open_file" />
                     </tooltip>
                  </Button>
                  <Button fx:id="vpsOpenBtn" mnemonicParsing="false" onAction="#onVpsOpen" styleClass="sm-button, sm-button-icon, link-component">
                     <graphic>
                        <FontIcon iconLiteral="mdi2o-open-in-new" iconSize="18" styleClass="c-icon-white" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%backglass.directb2s_admin.open_table_information_on_vps" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="14.0" left="18.0" right="18.0" top="16.0" />
         </padding>
      </HBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sm-transparent-scroll" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="versionPane" spacing="14.0">
               <children>
                  <!-- validation error of the selected backglass -->
                  <HBox fx:id="validationError" spacing="12.0" styleClass="sm-alert">
                     <children>
                        <StackPane maxHeight="24.0" maxWidth="24.0" minHeight="24.0" minWidth="24.0" styleClass="sm-alert-icon">
                           <children>
                              <FontIcon iconLiteral="mdi2e-exclamation-thick" iconSize="14" styleClass="c-icon-white" />
                           </children>
                        </StackPane>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="validationErrorLabel" styleClass="sm-alert-title" wrapText="true" />
                              <Label fx:id="validationErrorText" styleClass="sm-alert-text" wrapText="true" />
                           </children>
                        </VBox>
                        <HBox alignment="TOP_RIGHT" spacing="6.0">
                           <children>
                              <Button fx:id="validationUploadDmdBtn" mnemonicParsing="false" onAction="#onDMDUpload" styleClass="sm-alert-button" text="%backglass.sidebar.upload_dmd" />
                              <Button mnemonicParsing="false" onAction="#onValidationSettings" styleClass="sm-alert-button">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2c-cog" iconSize="16" styleClass="c-icon-error-text-light" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%backglass.directb2s_admin.open_validators_settings" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                     </padding>
                  </HBox>

                  <!-- no version of the backglass is active -->
                  <HBox fx:id="noneActiveInfo" alignment="CENTER_LEFT" spacing="10.0" styleClass="sm-inset">
                     <children>
                        <FontIcon iconLiteral="mdi2a-alert-outline" iconSize="18" styleClass="c-icon-warn" />
                        <Label styleClass="sm-text" text="%backglass.directb2s_sidebar.none_of_the_backglasses_is_currently_activated" wrapText="true" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                     </padding>
                  </HBox>

                  <!-- background and DMD image tiles -->
                  <GridPane hgap="14.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                     </columnConstraints>
                     <children>
                        <VBox spacing="10.0" styleClass="sm-tile">
                           <children>
                              <Label styleClass="sm-caption" text="%backglass.sidebar.caption_background" />
                              <StackPane fx:id="thumbnailImagePane" minHeight="200.0" minWidth="0.0" prefHeight="200.0" styleClass="sm-inset">
                                 <children>
                                    <ImageView fx:id="thumbnailImage" fitHeight="190.0" fitWidth="240.0" pickOnBounds="true" preserveRatio="true" />
                                    <Label fx:id="thumbnailEmptyLabel" styleClass="sm-hint" text="%backglass.directb2s_sidebar.no_image_data_available" wrapText="true">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2i-image-off-outline" iconSize="18" styleClass="c-icon-subtle" />
                                       </graphic>
                                    </Label>
                                    <ProgressIndicator fx:id="thumbnailProgress" maxHeight="36.0" maxWidth="36.0" />
                                 </children>
                              </StackPane>
                              <HBox alignment="CENTER_LEFT" spacing="6.0">
                                 <children>
                                    <Label fx:id="resolutionLabel" maxWidth="1.7976931348623157E308" styleClass="sm-small" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="downloadBackglassBtn" mnemonicParsing="false" onAction="#onBackglassDownload" styleClass="sm-button, sm-button-icon">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2d-download" iconSize="16" styleClass="c-icon-white" />
                                       </graphic>
                                       <tooltip>
                                          <Tooltip prefWidth="400.0" text="%backglass.directb2s_sidebar.export_the_backglass_image_and_save_it_on" wrapText="true" />
                                       </tooltip>
                                    </Button>
                                    <SplitMenuButton fx:id="useAsMediaBackglassBtn" mnemonicParsing="false" onAction="#onBackglassUseAsMedia" styleClass="sm-button, sm-button-icon">
                                       <items>
                                          <MenuItem mnemonicParsing="false" onAction="#onBackglassBulkImport" text="%backglass.bulk_import">
                                             <graphic>
                                                <FontIcon iconLiteral="mdi2i-image-multiple" iconSize="14" styleClass="c-icon-white" />
                                             </graphic>
                                          </MenuItem>
                                       </items>
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2i-image-plus" iconSize="16" styleClass="c-icon-white" />
                                       </graphic>
                                       <tooltip>
                                          <Tooltip prefWidth="400.0" text="%backglass.directb2s_sidebar.export_the_backglass_image_and_use_it_as" wrapText="true" />
                                       </tooltip>
                                    </SplitMenuButton>
                                 </children>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                           </padding>
                        </VBox>

                        <VBox spacing="10.0" styleClass="sm-tile" GridPane.columnIndex="1">
                           <children>
                              <Label styleClass="sm-caption" text="%backglass.sidebar.caption_full_dmd" />
                              <StackPane fx:id="loaderStackImages" minWidth="0.0">
                                 <children>
                                    <StackPane fx:id="dmdThumbnailImagePane" minHeight="200.0" minWidth="0.0" prefHeight="200.0" styleClass="sm-inset">
                                       <children>
                                          <ImageView fx:id="dmdThumbnailImage" fitHeight="190.0" fitWidth="240.0" pickOnBounds="true" preserveRatio="true" />
                                          <VBox fx:id="dmdEmptyBox" alignment="CENTER" spacing="10.0">
                                             <children>
                                                <FontIcon iconLiteral="mdi2i-image-off-outline" iconSize="26" styleClass="c-icon-subtle" />
                                                <Label styleClass="sm-hint" text="%backglass.sidebar.no_dmd_image" wrapText="true" />
                                                <Button fx:id="uploadDMDEmptyBtn" mnemonicParsing="false" onAction="#onDMDUpload" styleClass="sm-button" text="%backglass.sidebar.upload_image">
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdi2u-upload" iconSize="18" styleClass="c-icon-white" />
                                                   </graphic>
                                                   <tooltip>
                                                      <Tooltip prefWidth="400.0" text="%backglass.directb2s_sidebar.uploads_a_new_image_used_as_dmd_background" wrapText="true" />
                                                   </tooltip>
                                                </Button>
                                             </children>
                                          </VBox>
                                          <ProgressIndicator fx:id="dmdThumbnailProgress" maxHeight="36.0" maxWidth="36.0" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </StackPane>
                              <HBox alignment="CENTER_LEFT" spacing="6.0">
                                 <children>
                                    <Label fx:id="dmdResolutionLabel" maxWidth="1.7976931348623157E308" styleClass="sm-small" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="uploadDMDBtn" mnemonicParsing="false" onAction="#onDMDUpload" styleClass="sm-button, sm-button-icon">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2u-upload" iconSize="16" styleClass="c-icon-white" />
                                       </graphic>
                                       <tooltip>
                                          <Tooltip prefWidth="400.0" text="%backglass.directb2s_sidebar.uploads_a_new_image_used_as_dmd_background" wrapText="true" />
                                       </tooltip>
                                    </Button>
                                    <Button fx:id="downloadDMDBtn" mnemonicParsing="false" onAction="#onDMDDownload" styleClass="sm-button, sm-button-icon">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2d-download" iconSize="16" styleClass="c-icon-white" />
                                       </graphic>
                                       <tooltip>
                                          <Tooltip prefWidth="400.0" text="%backglass.directb2s_sidebar.export_the_dmd_image_and_save_it_on" wrapText="true" />
                                       </tooltip>
                                    </Button>
                                    <SplitMenuButton fx:id="useAsMediaDMDBtn" mnemonicParsing="false" onAction="#onDMDUseAsMedia" styleClass="sm-button, sm-button-icon">
                                       <items>
                                          <MenuItem mnemonicParsing="false" onAction="#onDMDBulkImport" text="%backglass.bulk_import">
                                             <graphic>
                                                <FontIcon iconLiteral="mdi2i-image-multiple" iconSize="14" styleClass="c-icon-white" />
                                             </graphic>
                                          </MenuItem>
                                       </items>
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2i-image-plus" iconSize="16" styleClass="c-icon-white" />
                                       </graphic>
                                       <tooltip>
                                          <Tooltip prefWidth="400.0" text="%backglass.directb2s_sidebar.export_the_dmd_image_and_use_it_as" wrapText="true" />
                                       </tooltip>
                                    </SplitMenuButton>
                                    <Button fx:id="deleteDMDBtn" mnemonicParsing="false" onAction="#onDMDDelete" styleClass="sm-danger-button, sm-button-icon">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2d-delete-outline" iconSize="16" styleClass="c-icon-error" />
                                       </graphic>
                                       <tooltip>
                                          <Tooltip text="%dialog.delete_dmd_image" />
                                       </tooltip>
                                    </Button>
                                 </children>
                              </HBox>
                           </children>
                           <padding>
                              <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                           </padding>
                        </VBox>
                     </children>
                  </GridPane>

                  <TabPane styleClass="primary-tabs" tabClosingPolicy="UNAVAILABLE">
                     <tabs>
                        <!-- ============================== Settings ============================== -->
                        <Tab text="%backglass.sidebar.tab_settings">
                           <content>
                              <VBox spacing="14.0">
                                 <children>
                                    <!-- Visibility -->
                                    <VBox styleClass="sm-tile">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sm-divider">
                                             <children>
                                                <Label styleClass="sm-title" text="%backglass.sidebar.visibility" />
                                             </children>
                                             <padding>
                                                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                                             </padding>
                                          </HBox>
                                          <GridPane hgap="12.0" vgap="12.0">
                                             <columnConstraints>
                                                <ColumnConstraints hgrow="ALWAYS" />
                                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" prefWidth="240.0" />
                                             </columnConstraints>
                                             <children>
                                                <Label styleClass="sm-text" text="%backglass.sidebar.grill" />
                                                <ComboBox fx:id="hideGrill" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" />
                                                <Label styleClass="sm-text" text="%backglass.sidebar.dmd" GridPane.rowIndex="1" />
                                                <ComboBox fx:id="hideDMD" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <Label styleClass="sm-text" text="%backglass.sidebar.background" GridPane.rowIndex="2" />
                                                <ComboBox fx:id="startBackground" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                <Label styleClass="sm-text" text="%backglass.sidebar.dual_mode" GridPane.rowIndex="3" />
                                                <ComboBox fx:id="dualModes" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                <Label styleClass="sm-text" text="%backglass.sidebar.hide_backglass" GridPane.rowIndex="4" />
                                                <CheckBox fx:id="hideB2SBackglass" mnemonicParsing="false" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                                <Label styleClass="sm-text" text="%backglass.sidebar.hide_b2s_dmd" GridPane.rowIndex="5" />
                                                <CheckBox fx:id="hideB2SDMD" mnemonicParsing="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                             </children>
                                             <padding>
                                                <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                                             </padding>
                                          </GridPane>
                                       </children>
                                    </VBox>

                                    <!-- Frame skipping -->
                                    <VBox styleClass="sm-tile">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sm-divider">
                                             <children>
                                                <Label styleClass="sm-title" text="%backglass.sidebar.frame_skipping" />
                                                <Label>
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="16" styleClass="c-icon-muted" />
                                                   </graphic>
                                                   <tooltip>
                                                      <Tooltip prefWidth="300.0" text="%backglass.directb2s_sidebar.only_enabled_for_backglasses_with_illuminations" wrapText="true" />
                                                   </tooltip>
                                                </Label>
                                                <Pane HBox.hgrow="ALWAYS" />
                                                <Label styleClass="sm-small" text="%backglass.sidebar.frame_skipping_hint" />
                                             </children>
                                             <padding>
                                                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                                             </padding>
                                          </HBox>
                                          <GridPane hgap="12.0" vgap="6.0">
                                             <columnConstraints>
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                             </columnConstraints>
                                             <children>
                                                <Label styleClass="sm-small" text="%backglass.sidebar.lamps" />
                                                <Label styleClass="sm-small" text="%backglass.sidebar.gi" GridPane.columnIndex="1" />
                                                <Label styleClass="sm-small" text="%backglass.sidebar.solenoids" GridPane.columnIndex="2" />
                                                <Label styleClass="sm-small" text="%backglass.sidebar.leds" GridPane.columnIndex="3" />
                                                <Spinner fx:id="skipLampFrames" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" />
                                                <Spinner fx:id="skipGIFrames" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <Spinner fx:id="skipSolenoidFrames" maxWidth="1.7976931348623157E308" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                                <Spinner fx:id="skipLEDFrames" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                             </children>
                                             <padding>
                                                <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                                             </padding>
                                          </GridPane>
                                       </children>
                                    </VBox>

                                    <!-- LEDs & glow -->
                                    <VBox styleClass="sm-tile">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sm-divider">
                                             <children>
                                                <Label styleClass="sm-title" text="%backglass.sidebar.leds_glow" />
                                             </children>
                                             <padding>
                                                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                                             </padding>
                                          </HBox>
                                          <GridPane hgap="12.0" vgap="12.0">
                                             <columnConstraints>
                                                <ColumnConstraints hgrow="ALWAYS" />
                                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" prefWidth="240.0" />
                                             </columnConstraints>
                                             <children>
                                                <Label styleClass="sm-text" text="%backglass.sidebar.led_type" />
                                                <ComboBox fx:id="usedLEDType" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" />
                                                <Label styleClass="sm-text" text="%backglass.sidebar.glowing" GridPane.rowIndex="1" />
                                                <ComboBox fx:id="glowing" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <Label styleClass="sm-text" text="%backglass.sidebar.led_bulb_light_on" GridPane.rowIndex="2" />
                                                <CheckBox fx:id="lightBulbOn" mnemonicParsing="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                             </children>
                                             <padding>
                                                <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                                             </padding>
                                          </GridPane>
                                       </children>
                                    </VBox>

                                    <!-- Launch -->
                                    <VBox styleClass="sm-tile">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sm-divider">
                                             <children>
                                                <Label styleClass="sm-title" text="%backglass.sidebar.launch" />
                                                <Pane HBox.hgrow="ALWAYS" />
                                                <Label fx:id="startAsExeServerLabel" styleClass="sm-small" />
                                             </children>
                                             <padding>
                                                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                                             </padding>
                                          </HBox>
                                          <GridPane hgap="12.0" vgap="12.0">
                                             <columnConstraints>
                                                <ColumnConstraints hgrow="ALWAYS" />
                                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" prefWidth="240.0" />
                                             </columnConstraints>
                                             <children>
                                                <Label styleClass="sm-text" text="%backglass.sidebar.start_as_exe" />
                                                <ComboBox fx:id="startAsExe" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" />
                                                <Label styleClass="sm-text" text="%backglass.sidebar.bring_forms" GridPane.rowIndex="1" />
                                                <ComboBox fx:id="formToPosition" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <Label styleClass="sm-text" text="%backglass.sidebar.no_focus" GridPane.rowIndex="2" />
                                                <CheckBox fx:id="formNoFocus" mnemonicParsing="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                             </children>
                                             <padding>
                                                <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                                             </padding>
                                          </GridPane>
                                       </children>
                                    </VBox>
                                 </children>
                                 <padding>
                                    <Insets top="14.0" />
                                 </padding>
                              </VBox>
                           </content>
                        </Tab>

                        <!-- ============================== Matching table ============================== -->
                        <Tab text="%backglass.sidebar.tab_matching_table">
                           <content>
                              <VBox>
                                 <children>
                                    <VBox styleClass="sm-tile">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sm-divider">
                                             <children>
                                                <Label styleClass="sm-title" text="%backglass.sidebar.tab_matching_table" />
                                                <Label>
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="16" styleClass="c-icon-muted" />
                                                   </graphic>
                                                   <tooltip>
                                                      <Tooltip prefWidth="300.0" text="%backglass.directb2s_sidebar.even_if_fuzzy_name_matching_is_enabled_for" wrapText="true" />
                                                   </tooltip>
                                                </Label>
                                                <Pane HBox.hgrow="ALWAYS" />
                                                <Button fx:id="dataManagerBtn" mnemonicParsing="false" onAction="#onTableDataManager" styleClass="sm-button, sm-button-icon">
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdi2l-lead-pencil" iconSize="18" styleClass="c-icon-white" />
                                                   </graphic>
                                                   <tooltip>
                                                      <Tooltip text="%backglass.directb2s_sidebar.edit_table_data" />
                                                   </tooltip>
                                                </Button>
                                                <Button fx:id="tableNavigateBtn" mnemonicParsing="false" onAction="#onOpenTable" styleClass="sm-button, sm-button-icon">
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdi2t-table-edit" iconSize="18" styleClass="c-icon-white" />
                                                   </graphic>
                                                   <tooltip>
                                                      <Tooltip text="%backglass.directb2s_sidebar.show_table_in_table_overview" />
                                                   </tooltip>
                                                </Button>
                                                <Button fx:id="gameLaunchBtn" mnemonicParsing="false" onAction="#onGameLaunch" styleClass="sm-button, sm-button-icon">
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdi2p-play" iconSize="18" styleClass="c-icon-ok" />
                                                   </graphic>
                                                   <tooltip>
                                                      <Tooltip text="%backglass.directb2s_sidebar.launch_game" />
                                                   </tooltip>
                                                </Button>
                                             </children>
                                             <padding>
                                                <Insets bottom="10.0" left="16.0" right="12.0" top="10.0" />
                                             </padding>
                                          </HBox>
                                          <GridPane hgap="16.0" styleClass="sm-inset" vgap="10.0">
                                             <columnConstraints>
                                                <ColumnConstraints hgrow="NEVER" />
                                                <ColumnConstraints hgrow="ALWAYS" />
                                             </columnConstraints>
                                             <children>
                                                <Label styleClass="sm-hint" text="%backglass.directb2s_sidebar.display_name" />
                                                <Label fx:id="gameLabel" styleClass="sm-text" text="-" GridPane.columnIndex="1" />
                                                <Label styleClass="sm-hint" text="%backglass.directb2s_sidebar.file_name" GridPane.rowIndex="1" />
