<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitMenuButton?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.backglassmanager.BackglassManagerController">
   <center>
      <SplitPane fx:id="splitPane" dividerPositions="0.62" styleClass="sm-split">
         <items>
            <!-- backglass list -->
            <VBox spacing="10.0">
               <children>
                  <!-- toolbar rows: no extra spacing between them, like the table overview -->
                  <VBox>
                     <children>
                        <HBox fx:id="toolbar" alignment="CENTER_LEFT" styleClass="sm-actionbar, sm-actionbar-flush">
                           <children>
                              <Button fx:id="filterBtn" mnemonicParsing="false" onAction="#onFilter" styleClass="sm-button-icon">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2f-filter-menu-outline" iconSize="18" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%backglass.directb2s_admin.toggle_filter_view" />
                                 </tooltip>
                              </Button>
                              <Button fx:id="reloadBtn" mnemonicParsing="false" onAction="#onReload" styleClass="sm-button-icon">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2r-reload" iconSize="18" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%backglass.directb2s_admin.reload_all_table_data" />
                                 </tooltip>
                              </Button>
                              <Separator orientation="VERTICAL" />
                              <StackPane alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                 <children>
                                    <TextField fx:id="searchTextField" minWidth="140.0" onKeyPressed="#onSearchKeyPressed" prefHeight="30.0" promptText="%backglass.directb2s_admin.search_backglass" />
                                    <Button fx:id="clearBtn" mnemonicParsing="false" onAction="#onClear" styleClass="ghost-icon-button">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2c-close-thick" iconSize="18" styleClass="c-icon-muted" />
                                       </graphic>
                                    </Button>
                                 </children>
                              </StackPane>
                              <Separator orientation="VERTICAL" />
                              <ComboBox fx:id="emulatorCombo" prefWidth="180.0" />
                              <Button fx:id="emulatorBtn" mnemonicParsing="false" onAction="#onEmulatorManager" styleClass="sm-button-icon">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2c-controller" iconSize="18" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%backglass.directb2s_admin.open_emulator_manager" />
                                 </tooltip>
                              </Button>
                              <Separator orientation="VERTICAL" />
                              <ComboBox fx:id="playlistCombo" prefHeight="30.0" prefWidth="170.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" styleClass="sm-actionbar, sm-actionbar-inset">
                           <children>
                              <Button fx:id="uploadBtn" mnemonicParsing="false" onAction="#onUpload" text="%common.upload">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2u-upload" iconSize="18" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%backglass.directb2s_admin.upload_a_new_backglass" />
                                 </tooltip>
                              </Button>
                              <Button fx:id="renameBtn" mnemonicParsing="false" onAction="#onRename" text="%backglass.directb2s_admin.rename">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2s-square-edit-outline" iconSize="18" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%backglass.directb2s_admin.rename_the_backglass_including_versions" />
                                 </tooltip>
                              </Button>
                              <Separator orientation="VERTICAL" />
                              <SplitMenuButton fx:id="resBtn" mnemonicParsing="false" onAction="#onResEdit" text="%backglass.directb2s_admin.res_editor">
                                 <items>
                                    <MenuItem mnemonicParsing="false" onAction="#onResBulkEdit" text="%backglass.directb2s_admin.res_bulk_edit">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2m-monitor-screenshot" iconSize="14" styleClass="c-icon-white" />
                                       </graphic>
                                    </MenuItem>
                                 </items>
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2i-image-edit-outline" iconSize="18" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%backglass.directb2s_admin.open_res_editor" />
                                 </tooltip>
                              </SplitMenuButton>
                              <Button fx:id="dmdPositionBtn" mnemonicParsing="false" onAction="#onDMDPosition" text="%backglass.directb2s_admin.dmd_position">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2t-target-variant" iconSize="18" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%backglass.directb2s_admin.adjust_dmd_position" />
                                 </tooltip>
                              </Button>
                              <Pane HBox.hgrow="ALWAYS" />
                              <Label fx:id="labelCount" styleClass="sm-hint" />
                           </children>
                           <padding>
                              <Insets />
                           </padding>
                        </HBox>
                     </children>
                  </VBox>
      
                  <!-- status filter pills of the listed backglasses (FilterPills) -->
                  <HBox fx:id="statusPills" alignment="CENTER_LEFT" spacing="8.0" />
      
                  <StackPane fx:id="loaderStack" VBox.vgrow="ALWAYS">
                     <children>
                        <StackPane fx:id="tableStack">
                           <children>
                              <TableView fx:id="tableView" onMouseClicked="#onTableMouseClicked">
                                 <columns>
                                    <TableColumn fx:id="statusColumn" minWidth="33" prefWidth="55.0" style="-fx-alignment: CENTER;" text="%backglass.directb2s_admin.status" />
                                    <TableColumn fx:id="displayNameColumn" prefWidth="300.0" style="-fx-alignment: BASELINE_LEFT;" text="%backglass.directb2s_admin.backglass" />
                                    <TableColumn fx:id="numberDirectB2SColumn" minWidth="50" prefWidth="90.0" style="-fx-alignment: CENTER;" text="%backglass.directb2s_admin.directb2s" />
                                    <TableColumn fx:id="tableColumn" minWidth="70" prefWidth="90.0" style="-fx-alignment: CENTER;" text="%backglass.directb2s_admin.table_match" />
                                    <TableColumn fx:id="fullDmdColumn" minWidth="50" style="-fx-alignment: CENTER;" text="%backglass.directb2s_admin.fulldmd" />
                                    <TableColumn fx:id="grillColumn" minWidth="50" prefWidth="70.0" style="-fx-alignment: CENTER;" text="%backglass.directb2s_admin.grill" />
                                    <TableColumn fx:id="scoreColumn" minWidth="50" prefWidth="70.0" style="-fx-alignment: CENTER;" text="%backglass.directb2s_admin.score" />
                                    <TableColumn fx:id="resColumn" minWidth="50" prefWidth="70.0" style="-fx-alignment: CENTER;" text="%backglass.directb2s_admin.res" />
                                    <TableColumn fx:id="frameColumn" minWidth="50" prefWidth="70.0" style="-fx-alignment: CENTER;" text="%backglass.directb2s_admin.frame" />
                                    <TableColumn fx:id="emulatorColumn" prefWidth="250.0" style="-fx-alignment: BASELINE_LEFT;" text="%backglass.directb2s_admin.emulator" />
                                 </columns>
                              </TableView>
                           </children>
                        </StackPane>
                     </children>
                  </StackPane>
               </children>
            </VBox>

            <fx:include fx:id="backglassManagerSideBar" minWidth="480.0" source="scene-directb2s-sidebar.fxml" />
         </items>
      </SplitPane>
   </center>
</BorderPane>
