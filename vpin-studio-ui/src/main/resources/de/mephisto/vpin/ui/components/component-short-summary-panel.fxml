<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="root" maxHeight="Infinity" maxWidth="Infinity" spacing="12.0" styleClass="sm-tile" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.components.ComponentShortSummaryController">
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label fx:id="titleLabel" maxWidth="Infinity" styleClass="sm-title" text="-" HBox.hgrow="ALWAYS" />
            <Label fx:id="statusLabel" minWidth="-Infinity" styleClass="sm-pill, sm-pill-unknown" text="-" />
         </children>
      </HBox>
      <GridPane fx:id="versionGrid" hgap="16.0" styleClass="sm-inset" vgap="8.0">
         <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="-Infinity" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
         </columnConstraints>
         <padding>
            <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
         </padding>
         <children>
            <Label styleClass="sm-hint" text="%components.overview.installed" />
            <Label fx:id="installedVersionLabel" styleClass="sm-text" text="-" GridPane.columnIndex="1" />
            <Label styleClass="sm-hint" text="%components.overview.latest" GridPane.rowIndex="1" />
            <Label fx:id="latestVersionLabel" styleClass="sm-text" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         </children>
      </GridPane>
      <Region VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Hyperlink fx:id="link" maxWidth="Infinity" onAction="#onLink" styleClass="sm-link" text="-" HBox.hgrow="ALWAYS">
               <graphic>
                  <FontIcon styleClass="c-icon-link" iconLiteral="mdi2o-open-in-new" iconSize="14" />
               </graphic>
            </Hyperlink>
            <Button fx:id="manageBtn" contentDisplay="RIGHT" minWidth="-Infinity" mnemonicParsing="false" onAction="#onManage" styleClass="sm-button" text="%components.overview.manage">
               <graphic>
                  <FontIcon styleClass="c-icon-white" iconLiteral="mdi2c-chevron-right" iconSize="16" />
               </graphic>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
