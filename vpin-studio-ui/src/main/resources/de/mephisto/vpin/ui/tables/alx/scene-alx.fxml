<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" styleClass="base-component" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.tables.alx.AlxController">
   <center>
      <StackPane fx:id="loaderStack">
         <children>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="sm-transparent-scroll">
               <content>
                  <HBox spacing="14.0">
                     <children>
                     <VBox fx:id="col1" minWidth="0.0" prefWidth="200.0" spacing="4.0" styleClass="sm-tile" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="sm-title" text="%tables.alx.alx.most_played" wrapText="true" />
                           <Label styleClass="sm-hint" text="%tables.alx.alx.number_of_times_a_table_has_been_launched" wrapText="true">
                              <VBox.margin>
                                 <Insets bottom="8.0" />
                              </VBox.margin>
                           </Label>
                           <VBox fx:id="mostPlayedWidget" spacing="2.0">
                              <VBox.margin>
                                 <Insets left="-8.0" right="-8.0" />
                              </VBox.margin>
                           </VBox>
                        </children>
                        <padding>
                           <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                        </padding>
                     </VBox>
                     <VBox fx:id="col2" minWidth="0.0" prefWidth="200.0" spacing="4.0" styleClass="sm-tile" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="sm-title" text="%tables.alx.alx.time_played" wrapText="true" />
                           <Label styleClass="sm-hint" text="%tables.alx.alx.total_emulation_time_by_table" wrapText="true">
                              <VBox.margin>
                                 <Insets bottom="8.0" />
                              </VBox.margin>
                           </Label>
                           <VBox fx:id="timePlayedWidget" spacing="2.0">
                              <VBox.margin>
                                 <Insets left="-8.0" right="-8.0" />
                              </VBox.margin>
                           </VBox>
                        </children>
                        <padding>
                           <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                        </padding>
                     </VBox>
                     <VBox fx:id="col3" minWidth="0.0" prefWidth="200.0" spacing="4.0" styleClass="sm-tile" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="sm-title" text="%tables.alx.alx.recorded_scores" wrapText="true" />
                           <Label styleClass="sm-hint" text="%tables.alx.alx.total_number_of_scores_recorded_by_vpin_studio" wrapText="true">
                              <VBox.margin>
                                 <Insets bottom="8.0" />
                              </VBox.margin>
                           </Label>
                           <VBox fx:id="scoresWidget" spacing="2.0">
                              <VBox.margin>
                                 <Insets left="-8.0" right="-8.0" />
                              </VBox.margin>
                           </VBox>
                        </children>
                        <padding>
                           <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                        </padding>
                     </VBox>
                     <VBox fx:id="col4" minWidth="0.0" prefWidth="200.0" spacing="4.0" styleClass="sm-tile" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="sm-title" text="%tables.alx.alx.last_played" wrapText="true" />
                           <Label styleClass="sm-hint" text="%tables.alx.alx.last_20_tables_played_and_date_time_played" wrapText="true">
                              <VBox.margin>
                                 <Insets bottom="8.0" />
                              </VBox.margin>
                           </Label>
                           <VBox fx:id="LastPlayedWidget" spacing="2.0">
                              <VBox.margin>
                                 <Insets left="-8.0" right="-8.0" />
                              </VBox.margin>
                           </VBox>
                        </children>
                        <padding>
                           <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                        </padding>
                     </VBox>
                     <VBox fx:id="tileList" minWidth="0.0" prefWidth="200.0" spacing="14.0" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </content>
            </ScrollPane>
         </children>
      </StackPane>
   </center>
   <top>
      <ToolBar styleClass="floating-toolbar, floating-toolbar-transparent" BorderPane.alignment="CENTER">
        <items>
            <Button fx:id="reloadBtn" mnemonicParsing="false" onAction="#onReload" styleClass="sm-button, sm-button-icon, c-text-white">
               <font>
                  <Font size="14.0" />
               </font>
               <graphic>
                  <FontIcon styleClass="c-icon-white" iconLiteral="mdi2r-reload" iconSize="18" />
               </graphic>
               <tooltip>
                  <Tooltip text="%backglass.directb2s_admin.reload_all_table_data" />
               </tooltip>
            </Button>
            <Separator orientation="VERTICAL" />
            <ComboBox fx:id="emulatorCombo" prefWidth="150.0" promptText="%recorder.recorder.all_vpx_tables" />
            <Separator layoutX="52.0" layoutY="10.0" orientation="VERTICAL" />
            <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#onDelete" styleClass="sm-danger-button, sm-button-icon, c-text-danger">
               <font>
                  <Font size="14.0" />
               </font>
               <graphic>
                  <FontIcon styleClass="c-icon-danger" iconLiteral="mdi2d-delete-outline" iconSize="18" text="󰧧" />
               </graphic>
               <tooltip>
                  <Tooltip text="%tables.alx.alx.delete_statistics" />
               </tooltip>
            </Button>
        </items>
      </ToolBar>
   </top>
</BorderPane>
