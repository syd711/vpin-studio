<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- rounded score tile: the sm-panel fill and border are on the outer stack, the table background image is set on the
     inner stack by the controller (clipped to the same radius) and darkened by the shade so the text stays readable.
     Layout: wheel | table name + manufacturer/year, rank pill + player + relative date | score -->
<StackPane fx:id="rootStack" alignment="CENTER_LEFT" prefWidth="0.0" styleClass="sm-panel" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.players.WidgetPlayerScoreController">
   <children>
      <StackPane fx:id="root">
         <children>
            <Region styleClass="sm-score-tile-shade" />
            <HBox alignment="CENTER_LEFT" spacing="18.0">
               <children>
                  <ImageView fx:id="wheelImageView" fitHeight="72.0" fitWidth="72.0" pickOnBounds="true" preserveRatio="true" />
                  <VBox alignment="CENTER_LEFT" minWidth="0.0" spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="BASELINE_LEFT" minWidth="0.0" spacing="10.0">
                           <children>
                              <Label fx:id="tableLabel" minWidth="0.0" styleClass="sm-title" text="%players.widget_highscore.loading" />
                              <Label fx:id="metaLabel" minWidth="0.0" styleClass="sm-hint" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="10.0">
                           <children>
                              <Label fx:id="positionLabel" minWidth="-Infinity" styleClass="sm-pill, sm-pill-unknown" text="#" />
                              <Label fx:id="nameLabel" minWidth="0.0" styleClass="sm-text" text="…" />
                              <Label fx:id="separatorLabel" minWidth="-Infinity" styleClass="sm-hint" text="·" />
                              <Label fx:id="changeDateLabel" minWidth="-Infinity" styleClass="sm-hint" text="…" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <Label fx:id="scoreLabel" minWidth="-Infinity" styleClass="c-text-white" text="…" />
               </children>
               <padding>
                  <Insets bottom="12.0" left="14.0" right="20.0" top="12.0" />
               </padding>
            </HBox>
         </children>
      </StackPane>
   </children>
   <padding>
      <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
   </padding>
</StackPane>
