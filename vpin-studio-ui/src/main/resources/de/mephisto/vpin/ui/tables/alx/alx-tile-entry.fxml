<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="4.0" styleClass="sm-tile" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.tables.alx.AlxTileEntryController">
   <children>
      <Label fx:id="titleLabel" styleClass="sm-title" text="-" wrapText="true" />
      <Label fx:id="valueLabel" styleClass="sm-kpi-value" text="-" />
      <Label fx:id="descriptionLabel" styleClass="sm-hint" text="-" wrapText="true" />
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
</VBox>
