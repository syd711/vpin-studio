<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="1180.0" styleClass="base-component" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.tables.dialogs.TableUploadController">
   <top>
      <fx:include fx:id="header" source="/de/mephisto/vpin/commons/fx/scene-dialog-header.fxml" />
   </top>
   <center>
      <VBox spacing="14.0" BorderPane.alignment="CENTER">
         <children>
            <!-- 1 · FILE -->
            <VBox spacing="12.0" styleClass="sm-tile, sm-tile-bordered">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="sm-caption" text="%tables.table_upload.section_file" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="sm-small" text="%tables.table_upload.supported_files" />
                     </children>
                  </HBox>
                  <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                     <children>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="sm-small" text="%tables.table_upload.emulator" />
                              <ComboBox fx:id="emulatorCombo" prefWidth="250.0" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="sm-small" text="%tables.table_upload.table_file_or_archive" />
                              <TextField fx:id="fileNameField" editable="false" prefHeight="30.0" promptText="%tables.table_upload.select_or_drop_a_table_or_archive_file" styleClass="sm-mono" />
                           </children>
                        </VBox>
                        <Button fx:id="fileBtn" mnemonicParsing="false" onAction="#onFileSelect" styleClass="sm-button" text="%tables.table_upload.choose_file">
                           <graphic>
                              <FontIcon iconLiteral="mdi2f-folder-open-outline" iconSize="18" styleClass="c-icon-white" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>

                  <!-- what was found in the selection: table file, VPS match, README -->
                  <GridPane styleClass="sm-inset, vps-facts">
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.34" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints vgrow="NEVER" />
                     </rowConstraints>
                     <children>
                        <VBox spacing="4.0" styleClass="vps-fact, vps-fact-left, vps-fact-last">
                           <children>
                              <Label styleClass="sm-caption" text="%tables.table_upload.fact_table_file" />
                              <Label fx:id="tableNameLabel" styleClass="sm-text, sm-mono" text="–" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" styleClass="vps-fact, vps-fact-left, vps-fact-last" GridPane.columnIndex="1">
                           <children>
                              <Label styleClass="sm-caption" text="%tables.table_upload.fact_vps_match" />
                              <Label fx:id="vpsMatchLabel" graphicTextGap="6.0" styleClass="sm-hint" text="–">
                                 <graphic>
                                    <FontIcon fx:id="vpsMatchIcon" iconLiteral="mdi2c-check" iconSize="16" styleClass="c-icon-ok" />
                                 </graphic>
                              </Label>
                           </children>
                        </VBox>
                        <VBox spacing="4.0" styleClass="vps-fact, vps-fact-last" GridPane.columnIndex="2">
                           <children>
                              <Label styleClass="sm-caption" text="%tables.table_upload.fact_readme" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label fx:id="readmeLabel" styleClass="sm-hint" text="–" />
                                    <Button fx:id="readmeBtn" mnemonicParsing="false" onAction="#onReadme" styleClass="sm-button, sm-button-small" text="%tables.patch_upload.view_readme">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2c-card-text-outline" iconSize="16" styleClass="c-icon-white" />
                                       </graphic>
                                    </Button>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </GridPane>

                  <!-- only shown when the archive bundles additional assets -->
                  <HBox fx:id="assetsView" alignment="CENTER_LEFT" spacing="12.0" styleClass="sm-inset">
                     <children>
                        <Label minWidth="-Infinity" styleClass="sm-caption" text="%tables.table_upload.bundled_assets" />
                        <FlowPane fx:id="assetsBox" hgap="6.0" vgap="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="assetAltSoundLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetAltColorLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetBackglassLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetCfgLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetDmdLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetIniLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetMusicLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetMediaLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetNvRamLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetPupPackLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetPovLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetResLabel" styleClass="sm-pill, sm-pill-unknown" />
                              <Label fx:id="assetRomLabel" styleClass="sm-pill, sm-pill-unknown" />
                           </children>
                        </FlowPane>
                        <Button fx:id="assetFilterBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#onAssetFilter" styleClass="sm-button, sm-button-small" text="%tables.table_upload.filter_selection">
                           <graphic>
                              <FontIcon iconLiteral="mdi2f-filter-outline" iconSize="16" styleClass="c-icon-white" />
                           </graphic>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                     </padding>
                  </HBox>

                  <VBox spacing="10.0">
                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <CheckBox fx:id="autofillCheckbox" mnemonicParsing="false" selected="true" styleClass="sm-accent-checkbox, sm-text" text="%tables.table_upload.auto_match_vps_entry_and_fill_table_data" />
                              <Label styleClass="sm-small, sm-checkbox-hint" text="%tables.table_upload.auto_match_description" wrapText="true" />
                           </children>
                        </VBox>
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                           <children>
                              <VBox spacing="2.0">
                                 <children>
                                    <CheckBox fx:id="subfolderCheckbox" mnemonicParsing="false" styleClass="sm-accent-checkbox, sm-text" text="%tables.table_upload.put_it_in_its_own_subfolder" />
                                    <Label styleClass="sm-small, sm-checkbox-hint" text="%tables.table_upload.subfolder_description" wrapText="true" />
                                 </children>
                              </VBox>
                              <TextField fx:id="subfolderText" disable="true" prefWidth="420.0" promptText="%tables.table_upload.subfolder_name" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
               </padding>
            </VBox>

            <!-- 2 · WHAT SHOULD HAPPEN? -->
            <Label styleClass="sm-caption" text="%tables.table_upload.section_action">
               <VBox.margin>
                  <Insets left="4.0" top="4.0" />
               </VBox.margin>
            </Label>
            <HBox spacing="14.0">
               <children>
                  <VBox fx:id="uploadImportBox" maxWidth="1.7976931348623157E308" minWidth="300.0" prefWidth="370.0" spacing="8.0" styleClass="sm-option-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <RadioButton fx:id="uploadAndImportRadio" mnemonicParsing="false" selected="true" styleClass="sm-accent-radio" />
                              <FontIcon iconLiteral="mdi2p-plus" iconSize="18" styleClass="c-icon-muted, sm-option-card-icon" />
                              <Label styleClass="sm-title" text="%tables.table_upload.add_as_new_table" wrapText="true" />
                           </children>
                        </HBox>
                        <Label fx:id="uploadAndImportDescription" styleClass="sm-hint, sm-option-card-body" text="%tables.table_upload.add_as_new_table_description" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox fx:id="uploadReplaceBox" maxWidth="1.7976931348623157E308" minWidth="300.0" prefWidth="370.0" spacing="8.0" styleClass="sm-option-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <RadioButton fx:id="uploadAndReplaceRadio" mnemonicParsing="false" styleClass="sm-accent-radio" />
                              <FontIcon iconLiteral="mdi2s-swap-horizontal" iconSize="18" styleClass="c-icon-muted, sm-option-card-icon" />
                              <Label styleClass="sm-title" text="%tables.table_upload.replace_selected_table" wrapText="true" />
                           </children>
                        </HBox>
                        <HBox styleClass="sm-option-card-body">
                           <children>
                              <Label fx:id="replaceTargetLabel" styleClass="sm-pill, sm-pill-unknown" text="–" />
                           </children>
                        </HBox>
                        <Label fx:id="uploadAndReplaceDescription" styleClass="sm-hint, sm-option-card-body" text="%tables.table_upload.replace_selected_table_description" wrapText="true" />
                        <Pane styleClass="sm-divider" minHeight="1.0" prefHeight="1.0">
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </Pane>
                        <VBox spacing="10.0" styleClass="sm-option-card-body">
                           <children>
                              <VBox spacing="2.0">
                                 <children>
                                    <CheckBox fx:id="keepNamesCheckbox" mnemonicParsing="false" styleClass="sm-accent-checkbox, sm-text" text="%tables.table_upload.keep_existing_file_name" wrapText="true" />
                                    <Label styleClass="sm-small, sm-checkbox-hint" text="%tables.table_upload.keep_existing_file_name_description" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="2.0">
                                 <children>
                                    <CheckBox fx:id="keepDisplayNamesCheckbox" mnemonicParsing="false" styleClass="sm-accent-checkbox, sm-text" text="%tables.table_upload.keep_existing_display_name" wrapText="true" />
                                    <Label styleClass="sm-small, sm-checkbox-hint" text="%tables.table_upload.keep_existing_display_name_description" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="2.0">
                                 <children>
                                    <CheckBox fx:id="backupTableOnOverwriteCheckbox" mnemonicParsing="false" styleClass="sm-accent-checkbox, sm-text" text="%tables.table_upload.back_up_current_table_first" wrapText="true" />
                                    <Label styleClass="sm-small, sm-checkbox-hint" text="%tables.table_upload.back_up_current_table_first_description" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox fx:id="uploadCloneBox" maxWidth="1.7976931348623157E308" minWidth="300.0" prefWidth="370.0" spacing="8.0" styleClass="sm-option-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <RadioButton fx:id="uploadAndCloneRadio" mnemonicParsing="false" styleClass="sm-accent-radio" />
                              <FontIcon iconLiteral="mdi2c-content-copy" iconSize="18" styleClass="c-icon-muted, sm-option-card-icon" />
                              <Label styleClass="sm-title" text="%tables.table_upload.clone_selected_table" wrapText="true" />
                           </children>
                        </HBox>
                        <HBox styleClass="sm-option-card-body">
                           <children>
                              <Label fx:id="cloneTargetLabel" styleClass="sm-pill, sm-pill-unknown" text="–" />
                           </children>
                        </HBox>
                        <Label fx:id="uploadAndCloneDescription" styleClass="sm-hint, sm-option-card-body" text="%tables.table_upload.clone_selected_table_description" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="16.0" left="16.0" right="16.0" top="12.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sm-footer" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="summaryLabel" maxWidth="1.7976931348623157E308" styleClass="sm-hint" HBox.hgrow="ALWAYS" />
            <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#onCancelClick" styleClass="default-button" text="%backglass.res_generator.cancel" />
            <Button fx:id="uploadBtn" mnemonicParsing="false" onAction="#onUploadClick" styleClass="submit-button" text="%tables.table_upload.upload_and_add" />
         </children>
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
