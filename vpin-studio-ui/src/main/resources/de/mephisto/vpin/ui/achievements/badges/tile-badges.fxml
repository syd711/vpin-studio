<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="8.0" style="-fx-background-color: #2A2A2A; -fx-background-radius: 6;" visible="false" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.achievements.badges.BadgesGridTileController">
   <fx:define>
      <ToggleGroup fx:id="filterGroup" />
   </fx:define>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="%achievements.badges" />
            <Label fx:id="countLabel" style="-fx-font-size: 14px; -fx-text-fill: #BDBDBD;" />
            <HBox>
               <children>
                  <ToggleButton fx:id="allBtn" mnemonicParsing="false" style="-fx-font-size: 14px;" selected="true" text="%achievements.filter.all" toggleGroup="$filterGroup" />
                  <ToggleButton fx:id="earnedBtn" mnemonicParsing="false" style="-fx-font-size: 14px;" text="%achievements.filter.earned" toggleGroup="$filterGroup" />
                  <ToggleButton fx:id="lockedBtn" mnemonicParsing="false" style="-fx-font-size: 14px;" text="%achievements.filter.locked" toggleGroup="$filterGroup" />
               </children>
            </HBox>
         </children>
      </HBox>
      <HBox fx:id="selectedPanel" alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: #222222; -fx-border-color: transparent transparent transparent #8C8CE0; -fx-border-width: 0 0 0 3;">
         <children>
            <StackPane fx:id="selectedMedalBox" />
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="selectedNameLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />
                  <Label fx:id="selectedDescriptionLabel" style="-fx-font-size: 14px; -fx-text-fill: #BDBDBD;" />
                  <Label fx:id="selectedStateLabel" />
               </children>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="6.0">
               <children>
                  <Label fx:id="displayBadgeLabel" style="-fx-font-size: 14px; -fx-text-fill: #BDBDBD;" />
                  <Button fx:id="showBadgeBtn" mnemonicParsing="false" onAction="#onShowBadge" text="%achievements.show_next_to_name" />
                  <Button fx:id="hideBadgeBtn" mnemonicParsing="false" onAction="#onHideBadge" text="%achievements.hide_next_to_name" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
         </padding>
      </HBox>
      <VBox fx:id="groupsBox" spacing="8.0" />
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
</VBox>
