<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- filter panel: see UI-STYLEGUIDE.md "Filter panel" -->
<VBox fx:id="filterRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="200.0" minWidth="-Infinity" prefWidth="286.0" styleClass="sm-panel" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.tables.TableFilterController">
   <children>
      <!-- header -->
      <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sm-divider">
         <children>
            <Label maxWidth="1.7976931348623157E308" styleClass="sm-caption" text="%common.filter" HBox.hgrow="ALWAYS" />
            <Button fx:id="resetBtn" mnemonicParsing="false" onAction="#onReset" styleClass="sm-button, sm-button-small" text="%backglass.directb2s_admin_filter.reset_all" />
            <Button mnemonicParsing="false" onAction="#toggle" styleClass="sm-button, sm-button-small">
               <graphic>
                  <FontIcon iconLiteral="mdi2a-arrow-expand-left" iconSize="14" styleClass="c-icon-white" />
               </graphic>
               <tooltip>
                  <Tooltip text="%backglass.directb2s_admin.toggle_filter_view" />
               </tooltip>
            </Button>
         </children>
         <padding>
            <Insets bottom="10.0" left="16.0" right="10.0" top="10.0" />
         </padding>
      </HBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sm-transparent-scroll" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="22.0">
               <children>
                  <!-- validation -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%preferences.table_validators" />
                        <CheckBox fx:id="missingAssetsCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.missing_table_assets" wrapText="true">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_are_missing_one_or_more" />
                           </tooltip>
                        </CheckBox>
                        <VBox spacing="6.0">
                           <children>
                              <HBox fx:id="configurationIssuesFilter" alignment="CENTER_LEFT" spacing="6.0">
                                 <children>
                                    <Label styleClass="sm-small" text="%tables.tables_overview_filter.validation_issue_type" />
                                    <Label>
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="14" styleClass="c-icon-muted" />
                                       </graphic>
                                       <tooltip>
                                          <Tooltip prefWidth="300.0" text="%tables.tables_overview_filter.changing_this_filter_requires_a_full_validation_of" wrapText="true" />
                                       </tooltip>
                                    </Label>
                                 </children>
                              </HBox>
                              <ComboBox fx:id="issueTypesCombo" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- table assets -->
                  <VBox fx:id="tableAssetFilters" spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%tables.tables_overview_filter.table_asset_filters" />
                        <CheckBox fx:id="withBackglassCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.backglass_available">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_a_backglass_configured" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="withPupPackCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.pup_pack_available">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_a_pup_pack_installed" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="withIniCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.ini_file_available">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_a_vpx_ini_configuration" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="withResCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.res_file_available">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_a_res_resolution_file" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="withPovCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.pov_file_available">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_a_pov_point_of" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="withAltColorCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.alt_color_available">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_alt_color_colorized_rom" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="withAltSoundCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.alt_sound_available">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_alt_sound_support" />
                           </tooltip>
                        </CheckBox>
                     </children>
                  </VBox>

                  <!-- configuration -->
                  <VBox fx:id="configurationFilters" spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%tables.tables_overview_filter.configuration_filters" />
                        <CheckBox fx:id="noHighscoreSettingsCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.missing_highscore_settings" wrapText="true">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_no_highscore_settings_configured" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="noVpsMappingTableCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.missing_vps_table_entry" wrapText="true">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_are_not_mapped_to_a_2" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="noVpsMappingVersionCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.missing_vps_version_entry" wrapText="true">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_are_not_mapped_to_a" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="withNVOffsetCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.nvoffset_set" wrapText="true">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_an_nvram_offset_configured" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="withAliasCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.rom_alias_set" wrapText="true">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_a_rom_alias_configured" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="noHighscoreSupportCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.highscores_not_supported" wrapText="true">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_for_which_highscore_tracking_is_not" />
                           </tooltip>
                        </CheckBox>
                        <CheckBox fx:id="iScoredCompetitionCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.iscored_game" wrapText="true">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.show_tables_that_are_linked_to_an_iscored" />
                           </tooltip>
                        </CheckBox>
                     </children>
                  </VBox>

                  <!-- tags: TagField added by TableFilterController -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%tables.tables_overview_filter.tags_filter" />
                        <VBox fx:id="tagsFilter" spacing="6.0" />
                        <CheckBox fx:id="todoTagsCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.todo_tags" wrapText="true">
                           <tooltip>
                              <Tooltip text="%tables.tables_overview_filter.todo_tags.tooltip" />
                           </tooltip>
                        </CheckBox>
                     </children>
                  </VBox>

                  <!-- data -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%tables.tables_overview_filter.data_filters" />
                        <VBox fx:id="statusSettings" spacing="6.0">
                           <children>
                              <Label styleClass="sm-small" text="%tables.tables_overview_filter.table_status" />
                              <ComboBox fx:id="statusCombo" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="sm-small" text="%tables.table_data_tab_comments.comments" />
                              <ComboBox fx:id="commentsCombo" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <HBox fx:id="notPlayedSettings" alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <CheckBox fx:id="notPlayedCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.not_played_yet">
                                 <tooltip>
                                    <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_never_been_launched" />
                                 </tooltip>
                              </CheckBox>
                              <Label>
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="14" styleClass="c-icon-muted" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip prefWidth="300.0" text="%tables.tables_overview_filter.based_on_launches_from_pinup_popper" wrapText="true" />
                                 </tooltip>
                              </Label>
                           </children>
                        </HBox>
                        <VBox fx:id="vpsFilters" spacing="8.0">
                           <children>
                              <CheckBox fx:id="vpsUpdatesCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.vps_updates_available" wrapText="true">
                                 <tooltip>
                                    <Tooltip text="%tables.tables_overview_filter.show_tables_for_which_a_vps_table_update" />
                                 </tooltip>
                              </CheckBox>
                              <CheckBox fx:id="versionUpdatesCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.new_version_available" wrapText="true">
                                 <tooltip>
                                    <Tooltip text="%tables.tables_overview_filter.show_tables_for_which_a_new_table_version" />
                                 </tooltip>
                              </CheckBox>
                              <CheckBox fx:id="notBackedUpCheckbox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.not_backed_up" wrapText="true">
                                 <tooltip>
                                    <Tooltip text="%tables.tables_overview_filter.show_tables_that_have_not_been_backed_up" />
                                 </tooltip>
                              </CheckBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- metadata -->
                  <VBox fx:id="metadataFilters" spacing="8.0">
                     <children>
                        <Label styleClass="sm-caption" text="%tables.tables_overview_filter.metadata_filters" />
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="sm-small" text="%tables.tables_overview_filter.table_type" />
                              <TextField fx:id="gameTypesField" promptText="%tables.tables_overview_filter.table_type_prompt" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="sm-small" text="%tables.tables_overview_filter.manufacturer" />
                              <TextField fx:id="manufacturersField" promptText="%tables.tables_overview_filter.manufacturer_prompt" />
                              <CheckBox fx:id="excludeManufacturersCheckBox" mnemonicParsing="false" styleClass="sm-text" text="%tables.tables_overview_filter.exclude_manufacturer" wrapText="true" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="sm-small" text="%tables.tables_overview_filter.min_rating" />
                              <ComboBox fx:id="minRatingCombo" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="sm-small" text="%tables.tables_overview_filter.year_range" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <TextField fx:id="yearFromField" prefColumnCount="4" promptText="%tables.tables_overview_filter.year_from" HBox.hgrow="ALWAYS" />
                                    <Label styleClass="sm-hint" text="–" />
                                    <TextField fx:id="yearToField" prefColumnCount="4" promptText="%tables.tables_overview_filter.year_to" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="18.0" left="16.0" right="16.0" top="16.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
