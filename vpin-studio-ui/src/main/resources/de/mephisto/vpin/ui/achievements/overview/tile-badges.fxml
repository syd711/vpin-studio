<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="Infinity" spacing="8.0" style="-fx-background-color: #2A2A2A; -fx-background-radius: 6;" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.achievements.overview.OverviewBadgesTileController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="%achievements.badges" />
            <Label fx:id="countLabel" style="-fx-font-size: 14px; -fx-text-fill: #BDBDBD;" />
            <Region HBox.hgrow="ALWAYS" />
            <Hyperlink mnemonicParsing="false" onAction="#onAllBadges" text="%achievements.all_badges" />
         </children>
      </HBox>
      <FlowPane fx:id="medalsPane" hgap="8.0" vgap="8.0" />
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
</VBox>
