<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox maxWidth="1.7976931348623157E308" spacing="14.0" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.tables.dialogs.TableDataTabScriptOptionsController">
   <padding>
      <Insets bottom="14.0" left="12.0" right="12.0" top="12.0" />
   </padding>
   <children>
      <BorderPane>
         <left>
            <Label styleClass="sm-title" text="%pref.pinemhi.options" BorderPane.alignment="CENTER_LEFT" />
         </left>
         <right>
            <Button fx:id="resetButton" disable="true" mnemonicParsing="false" onAction="#onResetClicked" styleClass="sm-button" text="%tables.table_data_tab_script_options.reset_to_defaults" BorderPane.alignment="CENTER_RIGHT">
               <graphic>
                  <FontIcon iconLiteral="mdi2r-restore" iconSize="18" styleClass="c-icon-white" />
               </graphic>
            </Button>
         </right>
      </BorderPane>

      <!-- loading / empty placeholder -->
      <StackPane fx:id="placeholderPane" styleClass="sm-tile" visible="true" VBox.vgrow="ALWAYS">
         <children>
            <VBox alignment="CENTER" maxWidth="500.0" spacing="12.0">
               <children>
                  <Label fx:id="placeholderLabel" styleClass="sm-hint" text="%tables.table_data_tab_script_options.select_a_vpx_table_to_see_its_script" textAlignment="CENTER" wrapText="true" />
                  <ProgressIndicator fx:id="loadingSpinner" maxHeight="40" maxWidth="40" visible="false" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
         </padding>
      </StackPane>

      <!-- options list, one row per option is built by the controller (slider or combo) -->
      <ScrollPane fx:id="optionsScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="sm-transparent-scroll" visible="false" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="optionsVBox" maxWidth="1.7976931348623157E308" spacing="18.0" styleClass="sm-tile">
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="14.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
