                     <BorderPane.margin>
                        <Insets top="6.0" />
                     </BorderPane.margin>
                        </BorderPane>
                    </center>
                </BorderPane>
            </bottom>
        </BorderPane>
    </center>
    <BorderPane.margin>
        <Insets right="12.0" />
    </BorderPane.margin>
