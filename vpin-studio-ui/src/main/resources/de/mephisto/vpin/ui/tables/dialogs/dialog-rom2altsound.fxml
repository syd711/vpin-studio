<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" prefWidth="760.0" styleClass="base-component" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.tables.dialogs.Rom2AltSoundDialogController">
   <top>
      <fx:include fx:id="header" source="/de/mephisto/vpin/commons/fx/scene-dialog-resizeable-header.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="base-component" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="12.0">
               <children>
                  <!-- project info, installed and latest version -->
                  <VBox minHeight="-Infinity" spacing="6.0" styleClass="info-container">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <Label styleClass="default-headline" text="rom2altsound" />
                              <Hyperlink fx:id="projectLink" onAction="#onProjectLink" text="https://github.com/Le-Syl21/rom2altsound" />
                           </children>
                        </HBox>
                        <Label maxWidth="700.0" styleClass="default-text" text="%tables.rom2altsound.description" wrapText="true" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <Label styleClass="default-text" text="%tables.rom2altsound.installed_version" />
                              <Label fx:id="installedVersionLabel" styleClass="default-text" text="-">
                                 <HBox.margin>
                                    <Insets right="18.0" />
                                 </HBox.margin>
                              </Label>
                              <Label styleClass="default-text" text="%tables.rom2altsound.latest_version" />
                              <Hyperlink fx:id="latestVersionLink" onAction="#onReleaseLink" text="-" />
                              <Pane HBox.hgrow="ALWAYS" />
                              <Button fx:id="updateBtn" mnemonicParsing="false" onAction="#onUpdate" text="%tables.rom2altsound.update">
                                 <graphic>
                                    <FontIcon iconColor="WHITE" iconLiteral="mdi2u-update" iconSize="18" />
                                 </graphic>
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                     </padding>
                  </VBox>
      
                              <!-- the ROM, as rom2altsound identified it -->
                  <GridPane hgap="6.0" minHeight="-Infinity" vgap="3.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="190.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="26.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="26.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="26.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="26.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="26.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="26.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="26.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Label styleClass="default-text" text="%tables.rom2altsound.table" />
                        <Label fx:id="tableLabel" styleClass="default-text" text="-" GridPane.columnIndex="1" />
                        <Label styleClass="default-text" text="%tables.rom2altsound.rom" GridPane.rowIndex="1" />
                        <Label fx:id="romLabel" styleClass="default-text" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label styleClass="default-text" text="%tables.rom2altsound.rom_file" GridPane.rowIndex="2" />
                        <Label fx:id="romFileLabel" styleClass="default-text" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label styleClass="default-text" text="%tables.rom2altsound.game" GridPane.rowIndex="3" />
                        <Label fx:id="gameLabel" styleClass="default-text" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label styleClass="default-text" text="%tables.rom2altsound.sound_board" GridPane.rowIndex="4" />
                        <Label fx:id="soundBoardLabel" styleClass="default-text" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        <Label styleClass="default-text" text="%tables.rom2altsound.rom_status" GridPane.rowIndex="5" />
                        <Label fx:id="romStatusLabel" styleClass="default-text" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        <Label styleClass="default-text" text="%tables.rom2altsound.target_folder" GridPane.rowIndex="6" />
                        <Label fx:id="targetFolderLabel" styleClass="default-text" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                     </children>
                  </GridPane>
      
                              <VBox fx:id="errorBox" styleClass="error-container">
                     <children>
                        <Label fx:id="errorText" styleClass="error-message" text="-" wrapText="true" />
                     </children>
                  </VBox>
      
                              <!-- the main options of the original UI that make sense for one ROM -->
                  <Label styleClass="default-title" text="%tables.rom2altsound.options" />
                  <GridPane fx:id="optionsGrid" hgap="6.0" minHeight="-Infinity" vgap="3.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="190.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Label styleClass="default-text" text="%tables.rom2altsound.volume" />
                        <HBox alignment="CENTER_LEFT" spacing="18.0" GridPane.columnIndex="1">
                           <children>
                              <RadioButton fx:id="volumeFactoryRadio" mnemonicParsing="false" selected="true" styleClass="default-text" text="%tables.rom2altsound.volume_factory">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="volumeGroup" />
                                 </toggleGroup>
                                 <tooltip>
                                    <Tooltip prefWidth="400.0" text="%tables.rom2altsound.volume_factory_tooltip" wrapText="true" />
                                 </tooltip>
                              </RadioButton>
                              <RadioButton fx:id="volumeReferenceRadio" mnemonicParsing="false" styleClass="default-text" text="%tables.rom2altsound.volume_reference" toggleGroup="$volumeGroup">
                                 <tooltip>
                                    <Tooltip prefWidth="400.0" text="%tables.rom2altsound.volume_reference_tooltip" wrapText="true" />
                                 </tooltip>
                              </RadioButton>
                           </children>
                        </HBox>
                        <Label styleClass="default-text" text="%tables.rom2altsound.max_secs" GridPane.rowIndex="1" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <Spinner fx:id="maxSecsSpinner" editable="true" prefWidth="100.0" />
                              <Label>
                                 <graphic>
                                    <FontIcon iconColor="WHITE" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip prefWidth="400.0" text="%tables.rom2altsound.max_secs_tooltip" wrapText="true" />
                                 </tooltip>
                              </Label>
                           </children>
                        </HBox>
                        <CheckBox fx:id="enableAltSoundCheckbox" mnemonicParsing="false" selected="true" styleClass="default-text" text="%tables.rom2altsound.enable_altsound" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     </children>
                  </GridPane>
      
                              <TitledPane fx:id="advancedPane" animated="false" expanded="false" minHeight="-Infinity" text="%tables.rom2altsound.advanced_options">
                     <content>
                        <VBox spacing="6.0">
                           <children>
                              <GridPane hgap="6.0" vgap="3.0">
                                 <columnConstraints>
                                    <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="190.0" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                 </columnConstraints>
                                 <rowConstraints>
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                 </rowConstraints>
                                 <children>
                                    <Label styleClass="default-text" text="%tables.rom2altsound.loop_max_secs" />
                                    <HBox alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="1">
                                       <children>
                                          <Spinner fx:id="loopMaxSecsSpinner" editable="true" prefWidth="100.0" />
                                          <Label>
                                             <graphic>
                                                <FontIcon iconColor="WHITE" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                                             </graphic>
                                             <tooltip>
                                                <Tooltip prefWidth="400.0" text="%tables.rom2altsound.loop_max_secs_tooltip" wrapText="true" />
                                             </tooltip>
                                          </Label>
                                       </children>
                                    </HBox>
                                    <Label styleClass="default-text" text="%tables.rom2altsound.intro_loop_secs" GridPane.rowIndex="1" />
                                    <HBox alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                       <children>
                                          <Spinner fx:id="introLoopSecsSpinner" editable="true" prefWidth="100.0" />
                                          <Label>
                                             <graphic>
                                                <FontIcon iconColor="WHITE" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                                             </graphic>
                                             <tooltip>
                                                <Tooltip prefWidth="400.0" text="%tables.rom2altsound.intro_loop_secs_tooltip" wrapText="true" />
                                             </tooltip>
                                          </Label>
                                       </children>
                                    </HBox>
                                 </children>
                              </GridPane>
                              <CheckBox fx:id="mergeTwinsCheckbox" mnemonicParsing="false" styleClass="default-text" text="%tables.rom2altsound.merge_twins" />
                              <Label styleClass="checkbox-description" text="%tables.rom2altsound.merge_twins_description" wrapText="true" />
                              <CheckBox fx:id="dcBlockCheckbox" mnemonicParsing="false" styleClass="default-text" text="%tables.rom2altsound.dc_block" />
                              <Label styleClass="checkbox-description" text="%tables.rom2altsound.dc_block_description" wrapText="true" />
                              <CheckBox fx:id="noFactoryCheckbox" mnemonicParsing="false" styleClass="default-text" text="%tables.rom2altsound.no_factory" />
                              <Label styleClass="checkbox-description" text="%tables.rom2altsound.no_factory_description" wrapText="true" />
                              <CheckBox fx:id="checkDuckingCheckbox" mnemonicParsing="false" styleClass="default-text" text="%tables.rom2altsound.check_ducking" />
                              <Label styleClass="checkbox-description" text="%tables.rom2altsound.check_ducking_description" wrapText="true" />
                              <CheckBox fx:id="noChipCheckCheckbox" mnemonicParsing="false" styleClass="default-text" text="%tables.rom2altsound.no_chip_check" />
                              <Label styleClass="checkbox-description" text="%tables.rom2altsound.no_chip_check_description" wrapText="true" />
                              <CheckBox fx:id="bsmtHleCheckbox" mnemonicParsing="false" styleClass="default-text" text="%tables.rom2altsound.bsmt_hle" />
                              <Label styleClass="checkbox-description" text="%tables.rom2altsound.bsmt_hle_description" wrapText="true" />
                           </children>
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                        </VBox>
                     </content>
                  </TitledPane>
      
                  <Label maxWidth="730.0" minHeight="-Infinity" styleClass="preference-description" text="%tables.rom2altsound.gsound_hint" wrapText="true" />
               </children>
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="BASELINE_RIGHT" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#onCancelClick" styleClass="default-button" text="%common.cancel">
               <HBox.margin>
                  <Insets right="12.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="createBtn" mnemonicParsing="false" onAction="#onCreateClick" styleClass="submit-button" text="%tables.rom2altsound.create" />
         </children>
         <BorderPane.margin>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
</BorderPane>
