<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- The sections are moved into the left column of the component update panel: version first, installation last. -->
<VBox spacing="22.0" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.components.ComponentSummaryController">
   <children>
      <!-- version -->
      <VBox fx:id="versionSection" spacing="12.0">
         <children>
            <Label styleClass="sm-caption" text="%components.tab.version" />
            <GridPane hgap="10.0" styleClass="sm-inset">
               <columnConstraints>
                  <ColumnConstraints minWidth="10.0" percentWidth="44.0" />
                  <ColumnConstraints halignment="CENTER" minWidth="10.0" percentWidth="12.0" />
                  <ColumnConstraints minWidth="10.0" percentWidth="44.0" />
               </columnConstraints>
               <padding>
                  <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
               </padding>
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="sm-small" text="%components.overview.installed" />
                        <Label fx:id="installedVersionLabel" styleClass="sm-text" text="-" wrapText="true" />
                     </children>
                  </VBox>
                  <FontIcon styleClass="c-icon-disabled" iconLiteral="mdi2a-arrow-right" iconSize="18" GridPane.columnIndex="1" />
                  <VBox spacing="4.0" GridPane.columnIndex="2">
                     <children>
                        <Label styleClass="sm-small" text="%components.tab.latest_release" />
                        <Label fx:id="latestVersionLabel" styleClass="sm-text" text="-" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </GridPane>
            <HBox fx:id="statusRow" alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label fx:id="statusLabel" minWidth="-Infinity" styleClass="sm-pill, sm-pill-unknown" text="-" />
                  <Label fx:id="lastCheckLabel" styleClass="sm-small" text="-" />
               </children>
            </HBox>
            <FlowPane hgap="6.0" vgap="6.0">
               <children>
                  <Button fx:id="resetVersionBtn" mnemonicParsing="false" onAction="#onVersionReset" styleClass="sm-button, sm-button-small" text="%components.tab.reset_version">
                     <tooltip>
                        <Tooltip prefWidth="300.0" text="%components.component_summary_panel.this_will_set_the_latest_available_version_as" wrapText="true" />
                     </tooltip>
                  </Button>
                  <Button fx:id="setVersionBtn" mnemonicParsing="false" onAction="#onVersionSet" styleClass="sm-button, sm-button-small" text="%components.tab.set_as_installed">
                     <tooltip>
                        <Tooltip prefWidth="300.0" text="%components.component_summary_panel.this_will_set_the_latest_available_version_as" wrapText="true" />
                     </tooltip>
                  </Button>
                  <Button fx:id="ignoreBtn" mnemonicParsing="false" onAction="#onVersionIgnore" styleClass="sm-button, sm-button-small" text="%components.tab.ignore_version">
                     <tooltip>
                        <Tooltip prefWidth="300.0" text="%dialog.the_previous_version_will_be_used_as" wrapText="true" />
                     </tooltip>
                  </Button>
               </children>
            </FlowPane>
         </children>
      </VBox>

      <!-- installation -->
      <VBox fx:id="installationSection" spacing="12.0">
         <children>
            <Label styleClass="sm-caption" text="%components.tab.installation" />
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="sm-small" text="%components.tab.folder" />
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label fx:id="folderLabel" maxWidth="Infinity" styleClass="sm-text" text="-" HBox.hgrow="ALWAYS" />
                        <Button fx:id="folderBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#onFolderSelect" styleClass="sm-button" text="%components.tab.change_folder">
                           <tooltip>
                              <Tooltip prefWidth="300.0" text="%components.component_summary_panel.if_no_folder_is_selected_the_default_resolving" wrapText="true" />
                           </tooltip>
                        </Button>
                        <Button fx:id="folderResetBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#onFolderReset" styleClass="sm-button" text="%components.tab.reset_folder">
                           <tooltip>
                              <Tooltip prefWidth="300.0" text="%components.component_summary_panel.this_will_reset_the_target_folder_to" wrapText="true" />
                           </tooltip>
                        </Button>
                     </children>
                  </HBox>
                  <Label styleClass="sm-small" text="%components.component_summary_panel.folder_description" wrapText="true" />
               </children>
            </VBox>
            <GridPane hgap="16.0" vgap="8.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" minWidth="-Infinity" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
               </columnConstraints>
               <children>
                  <Label styleClass="sm-hint" text="%components.tab.last_modified" />
                  <Label fx:id="lastModifiedLabel" styleClass="sm-text" text="-" GridPane.columnIndex="1" />
                  <Label styleClass="sm-hint" text="%components.tab.source" GridPane.rowIndex="1" />
                  <Hyperlink fx:id="githubLink" onAction="#onHyperlink" styleClass="sm-link" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <graphic>
                        <FontIcon styleClass="c-icon-link" iconLiteral="mdi2o-open-in-new" iconSize="14" />
                     </graphic>
                  </Hyperlink>
               </children>
            </GridPane>
         </children>
      </VBox>
   </children>
</VBox>
