<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="14.0" styleClass="sm-tile" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.players.BuiltInPlayersController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Button fx:id="reloadBtn" mnemonicParsing="false" onAction="#onReload" styleClass="sm-button, sm-button-icon">
               <graphic>
                  <FontIcon styleClass="c-icon-white" iconLiteral="mdi2r-reload" iconSize="18" />
               </graphic>
            </Button>
            <StackPane alignment="CENTER_RIGHT" HBox.hgrow="SOMETIMES">
               <children>
                  <TextField fx:id="searchTextField" prefWidth="280.0" promptText="%players.builtin_users.search_player" styleClass="sm-search-field" />
                  <FontIcon iconLiteral="mdi2m-magnify" iconSize="16" mouseTransparent="true" styleClass="c-icon-muted" StackPane.alignment="CENTER_LEFT">
                     <StackPane.margin>
                        <Insets left="10.0" />
                     </StackPane.margin>
                  </FontIcon>
                  <Button fx:id="clearBtn" mnemonicParsing="false" onAction="#onClear" styleClass="ghost-icon-button">
                     <graphic>
                        <FontIcon styleClass="c-icon-muted" iconLiteral="mdi2c-close" iconSize="16" />
                     </graphic>
                  </Button>
               </children>
            </StackPane>
            <Separator orientation="VERTICAL" prefHeight="24.0">
               <HBox.margin>
                  <Insets left="4.0" right="4.0" />
               </HBox.margin>
            </Separator>
            <Button mnemonicParsing="false" onAction="#onAdd" text="%competitions.competitions_discord.add" styleClass="sm-button">
               <graphic>
                  <FontIcon styleClass="c-icon-white" iconLiteral="mdi2p-plus" iconSize="18" />
               </graphic>
            </Button>
            <Button fx:id="editBtn" mnemonicParsing="false" onAction="#onEdit" text="%competitions.competitions_discord.edit" styleClass="sm-button">
               <graphic>
                  <FontIcon styleClass="c-icon-white" iconLiteral="mdi2p-pencil-outline" iconSize="18" />
               </graphic>
            </Button>
            <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#onDelete" text="%backups.backups.delete" styleClass="sm-danger-button">
               <graphic>
                  <FontIcon styleClass="c-icon-error" iconLiteral="mdi2d-delete-outline" iconSize="18" />
               </graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="playerCountLabel" styleClass="sm-small" />
         </children>
      </HBox>
      <StackPane fx:id="tableStack" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tableView" styleClass="sm-table">
               <columns>
                  <TableColumn fx:id="avatarColumn" minWidth="80.0" prefWidth="80.0" maxWidth="80.0" resizable="false" sortable="false" text="%players.builtin_users.avatar" />
                  <TableColumn fx:id="nameColumn" minWidth="120.0" prefWidth="220.0" styleClass="sm-table-bold" text="%cards.highscore_cards.display_name" />
                  <TableColumn fx:id="initialsColumn" minWidth="80.0" prefWidth="100.0" styleClass="sm-table-mono" text="%players.builtin_users.initials" />
                  <TableColumn fx:id="adminColumn" minWidth="110.0" prefWidth="140.0" text="%players.builtin_users.vpin_default_player" />
                  <TableColumn fx:id="maniaPlayerColumn" minWidth="130.0" prefWidth="170.0" text="%players.builtin_users.vpin_mania_account" />
                  <TableColumn fx:id="columnCreatedAt" minWidth="120.0" prefWidth="180.0" text="%backups.backups.created_at" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
               </columnResizePolicy>
            </TableView>
         </children>
      </StackPane>
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
</VBox>
