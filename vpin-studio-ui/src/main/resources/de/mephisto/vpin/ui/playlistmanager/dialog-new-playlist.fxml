   </top>
   <center>
      <VBox>
         <children>
            <GridPane hgap="8.0" styleClass="sm-tile, sm-tile-bordered" vgap="8.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="110.0" prefWidth="110.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
               <children>
                  <Label styleClass="sm-text" text="%backglass.directb2s_sidebar.name" />
                  <TextField fx:id="nameField" maxWidth="1.7976931348623157E308" promptText="%playlistmanager.new_playlist.enter_new_playlist_name" GridPane.columnIndex="1" />
                  <Label styleClass="sm-text" text="%cards.highscore_cards.emulator" GridPane.rowIndex="1" />
                  <ComboBox fx:id="emulatorCombo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               </children>
               <padding>
                  <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
