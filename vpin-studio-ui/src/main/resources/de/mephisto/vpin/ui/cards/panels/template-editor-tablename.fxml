<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.Pane?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="settingsPane" stylesheets="@../../stylesheet.css" text="" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.cards.panels.LayerEditorTableNameController">
   <graphic>
      <HBox fx:id="layerHeader" alignment="CENTER_LEFT" spacing="10.0" styleClass="designer-layer-header">
         <children>
            <FontIcon iconLiteral="mdi2f-format-text" iconSize="18" styleClass="c-icon-muted" />
            <Label fx:id="layerNameLabel" styleClass="designer-layer-name" text="%cards.designer.layer_table_name" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="eyeBtn" mnemonicParsing="false" styleClass="designer-layer-button">
               <graphic>
                  <FontIcon iconLiteral="mdi2e-eye-outline" iconSize="18" styleClass="c-icon-muted" />
               </graphic>
               <tooltip>
                  <Tooltip text="%cards.template_editor_tablename.toggle_table_name_visibility" />
               </tooltip>
            </Button>
            <ToggleButton fx:id="lockBtn" mnemonicParsing="false" onAction="#onLockToggle" styleClass="designer-layer-button">
               <graphic>
                  <FontIcon iconLiteral="mdi2l-lock-open-variant-outline" iconSize="18" styleClass="c-icon-muted" />
               </graphic>
               <tooltip>
                  <Tooltip text="%cards.template_editor_background.lock_these_properties_for_custom_templates" />
               </tooltip>
            </ToggleButton>
         </children>
      </HBox>
  </graphic>
   <content>
      <ScrollPane hbarPolicy="NEVER">
         <content>
            <VBox styleClass="accordion-container">
               <children>
                  <Label text="%cards.template_editor_tablename.table_font" styleClass="c-text-white">
                    <font>
                      <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                      <Insets top="6.0" />
                    </VBox.margin>
                  </Label>
                  <BorderPane>
                    <left>
                      <Label fx:id="tableFontLabel" prefHeight="20.0" prefWidth="170.0" styleClass="sm-text" BorderPane.alignment="CENTER">
                          <font>
                            <Font size="14.0" />
                          </font>
                      </Label>
                    </left>
                    <right>
                      <HBox spacing="3.0" BorderPane.alignment="CENTER">
                          <children>
                            <Button mnemonicParsing="false" onAction="#onFontTableSelect" styleClass="sm-button, sm-button-icon">
                                <font>
                                  <Font size="14.0" />
                                </font>
                                <graphic>
                                  <FontIcon styleClass="c-icon-white" iconLiteral="bi-fonts" onDragDetected="#onFontTableSelect" />
                                </graphic>
                            </Button>
                            <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onFontTableApplyAll" styleClass="sm-button, sm-button-icon">
                                <font>
                                  <Font size="14.0" />
                                </font>
                                <graphic>
                                  <FontIcon styleClass="c-icon-white" iconLiteral="mdi2c-check-all" onDragDetected="#onFontTableSelect" />
                                </graphic>
                                <tooltip>
                                  <Tooltip text="%cards.template_editor_scores.apply_selected_font_settings_to_all_templates" />
                                </tooltip>
                            </Button>
                          </children>
                      </HBox>
                    </right>
                  </BorderPane>

                  <HBox alignment="BASELINE_LEFT" spacing="6.0">
                    <children>
                      <CheckBox fx:id="tableUseDefaultColor" mnemonicParsing="false" text="%cards.template_editor_tablename.use_default_color" styleClass="c-text-white">
                          <font>
                            <Font size="14.0" />
                          </font>
                      </CheckBox>
                      <Label>
                          <graphic>
                            <FontIcon styleClass="c-icon-white" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                          </graphic>
                          <tooltip>
                            <Tooltip text="%cards.template_editor_tablename.when_checked_the_table_name_is_rendered_with" />
                          </tooltip>
                      </Label>
                    </children>
                    <VBox.margin>
                      <Insets top="12.0" />
                    </VBox.margin>
                  </HBox>

                  <VBox fx:id="tableColorBox" spacing="3.0">
                     <children>
                        <Label text="%cards.template_editor_tablename.table_name_color" styleClass="c-text-white">
                        <font>
                           <Font size="14.0" />
                        </font>
                        </Label>
                        <ColorPicker fx:id="tableFontColorSelector">
                        </ColorPicker>
                     </children>
                     <VBox.margin>
                        <Insets left="26.0" top="3.0" />
                     </VBox.margin>
                  </VBox>

                  <HBox alignment="BASELINE_LEFT" spacing="6.0">
                    <children>
                      <CheckBox fx:id="tableUseVpsNameCheckbox" mnemonicParsing="false" text="%cards.template_editor_tablename.use_vps_name" styleClass="c-text-white">
                          <font>
                            <Font size="14.0" />
                          </font>
                      </CheckBox>
                      <Label>
                          <graphic>
                            <FontIcon styleClass="c-icon-white" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                          </graphic>
                          <tooltip>
                            <Tooltip text="%cards.template_editor_tablename.use_vps_name_instead_of_display_name_allowing" />
                          </tooltip>
                      </Label>
                    </children>
                    <VBox.margin>
                      <Insets top="12.0" />
                    </VBox.margin>
                  </HBox>

                  <HBox fx:id="tableRenderManufacturerBox" alignment="BASELINE_LEFT" spacing="6.0">
                    <children>
                      <CheckBox fx:id="tableRenderManufacturerCheckbox" mnemonicParsing="false" text="%cards.template_editor_tablename.render_manufacturer" styleClass="c-text-white">
                          <font>
                            <Font size="14.0" />
                          </font>
                      </CheckBox>
                      <Label>
                          <graphic>
                            <FontIcon styleClass="c-icon-white" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                          </graphic>
                          <tooltip>
                            <Tooltip text="%cards.template_editor_tablename.when_checked_the_manufacturer_is_included_in_the" />
                          </tooltip>
                      </Label>
                    </children>
                    <VBox.margin>
                      <Insets left="26.0" top="6.0" />
                    </VBox.margin>
                  </HBox>

                  <HBox fx:id="tableRenderYearBox" alignment="BASELINE_LEFT" spacing="6.0">
                    <children>
                      <CheckBox fx:id="tableRenderYearCheckbox" mnemonicParsing="false" text="%cards.template_editor_tablename.render_year" styleClass="c-text-white">
                          <font>
                            <Font size="14.0" />
                          </font>
                      </CheckBox>
                      <Label>
                          <graphic>
                            <FontIcon styleClass="c-icon-white" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                          </graphic>
                          <tooltip>
                            <Tooltip text="%cards.template_editor_tablename.when_checked_the_year_is_included_in_the" />
                          </tooltip>
                      </Label>
                    </children>
                    <VBox.margin>
                      <Insets bottom="12.0" left="26.0" top="6.0" />
                    </VBox.margin>
                  </HBox>

                  <fx:include fx:id="position" source="template-subeditor-position.fxml" />

               </children>
               <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </content>
</TitledPane>
