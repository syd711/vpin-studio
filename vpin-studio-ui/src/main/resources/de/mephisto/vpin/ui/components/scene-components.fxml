<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="base-component" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.components.ComponentsController">
   <center>
      <BorderPane fx:id="root">
         <center>
            <BorderPane styleClass="subpanel" BorderPane.alignment="CENTER">
               <center>
                  <TabPane fx:id="tabPane" styleClass="primary-tabs" tabClosingPolicy="UNAVAILABLE">
                     <tabs>
                        <Tab fx:id="overviewTab" closable="false" styleClass="sub-tab" text="%components.components.overview" />
                        <Tab fx:id="vpxTab" closable="false" text="%components.components.visual_pinball" />
                        <Tab fx:id="mameTab" closable="false" text="%components.components.vpin_mame" />
                        <Tab fx:id="b2sTab" closable="false" text="%components.components.b2s_server" />
                        <Tab fx:id="freezyTab" closable="false" text="%components.components.freezy" />
                        <Tab fx:id="flexDMDTab" closable="false" text="%components.components.flexdmd" />
                        <!--<Tab fx:id="serumTab" closable="false" text="%components.components.serum" />-->
                        <Tab fx:id="doflinxTab" closable="false" text="%components.components.doflinx" />
                        <Tab fx:id="dofTab" closable="false" text="%components.components.dof" />
                     </tabs>
                  </TabPane>
               </center>
               <top>
                  <VBox fx:id="componentLoader" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" styleClass="base-component" BorderPane.alignment="CENTER">
                     <BorderPane.margin>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                     </BorderPane.margin>
                     <children>
                        <ProgressIndicator prefHeight="200.0" prefWidth="200.0" />
                        <Label fx:id="loaderLabel" styleClass="c-text-white" text="%components.components.loading_component_information">
                           <font>
                              <Font size="18.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="24.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
               </top>
            </BorderPane>
         </center>
         <BorderPane.margin>
            <Insets bottom="12.0" right="12.0" />
         </BorderPane.margin>
      </BorderPane>
   </center>
</BorderPane>
