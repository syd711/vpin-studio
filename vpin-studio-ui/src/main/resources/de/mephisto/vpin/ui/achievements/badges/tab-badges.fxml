<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.achievements.badges.BadgesTabController">
   <left>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
         <content>
            <fx:include fx:id="levelTile" source="tile-level.fxml" />
         </content>
         <BorderPane.margin>
            <Insets right="10.0" top="10.0" />
         </BorderPane.margin>
      </ScrollPane>
   </left>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
         <content>
            <fx:include fx:id="badgesTile" source="tile-badges.fxml" />
         </content>
         <BorderPane.margin>
            <Insets top="10.0" />
         </BorderPane.margin>
      </ScrollPane>
   </center>
</BorderPane>
