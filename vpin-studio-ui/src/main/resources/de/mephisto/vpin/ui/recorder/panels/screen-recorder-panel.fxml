<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- recording options card of one screen -->
<VBox fx:id="root" styleClass="sm-tile" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.recorder.panels.ScreenRecorderPanelController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="sm-divider">
         <children>
            <FontIcon iconLiteral="mdi2m-monitor" iconSize="18" styleClass="c-icon-muted" />
            <Label fx:id="screenName" styleClass="sm-title" text="-" />
            <Pane HBox.hgrow="ALWAYS" />
            <Label fx:id="resolutionLabel" styleClass="sm-small" />
         </children>
         <padding>
            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
         </padding>
      </HBox>

      <HBox spacing="16.0">
         <children>
            <!-- options -->
            <VBox minWidth="-Infinity" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" minHeight="30.0" spacing="12.0">
                     <children>
                        <Label minWidth="150.0" prefWidth="150.0" styleClass="sm-text" text="%recorder.screen.record_mode" />
                        <ComboBox fx:id="recordModeComboBox" prefWidth="180.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" minHeight="30.0" spacing="12.0">
                     <children>
                        <Label minWidth="150.0" prefWidth="150.0" styleClass="sm-text" text="%recorder.screen.duration" />
                        <Spinner fx:id="durationSpinner" editable="true" prefWidth="90.0" />
                        <Label styleClass="sm-small" text="%monitor.cab_monitor.seconds" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" minHeight="30.0" spacing="12.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" minWidth="150.0" prefWidth="150.0" spacing="6.0">
                           <children>
                              <Label styleClass="sm-text" text="%recorder.screen.delay" />
                              <Label>
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="16" styleClass="c-icon-muted" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip prefWidth="300.0" text="%recorder.screen_recorder_panel.the_amount_of_seconds_to_wait_after_the" wrapText="true" />
                                 </tooltip>
                              </Label>
                           </children>
                        </HBox>
                        <Spinner fx:id="delaySpinner" editable="true" prefWidth="90.0" />
                        <Label styleClass="sm-small" text="%monitor.cab_monitor.seconds" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" minHeight="30.0" spacing="12.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" minWidth="150.0" prefWidth="150.0" spacing="6.0">
                           <children>
                              <Label styleClass="sm-text" text="%recorder.screen.in_game" />
                              <Label>
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="16" styleClass="c-icon-muted" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip prefWidth="300.0" text="%recorder.screen_recorder_panel.if_enabled_this_screen_will_be_recorded_when" wrapText="true" />
                                 </tooltip>
                              </Label>
                           </children>
                        </HBox>
                        <CheckBox fx:id="inGameRecordingCheckbox" mnemonicParsing="false" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" minHeight="30.0" spacing="12.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" minWidth="150.0" prefWidth="150.0" spacing="6.0">
                           <children>
                              <Label styleClass="sm-text" text="%recorder.screen.expert" />
                              <Label>
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="16" styleClass="c-icon-muted" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip prefWidth="300.0" text="%recorder.screen_recorder_panel.if_enabled_a_custom_ffmpeg_command_can_be" wrapText="true" />
                                 </tooltip>
                              </Label>
                           </children>
                        </HBox>
                        <CheckBox fx:id="expertModeCheckbox" mnemonicParsing="false" />
                        <Button fx:id="settingsBtn" mnemonicParsing="false" onAction="#onSettings" styleClass="sm-button, sm-button-small" text="%recorder.screen.edit_command">
                           <graphic>
                              <FontIcon iconLiteral="mdi2c-console" iconSize="16" styleClass="c-icon-white" />
                           </graphic>
                           <tooltip>
                              <Tooltip text="%recorder.screen_recorder_panel.edit_the_ffmpeg_exe_command" />
                           </tooltip>
                        </Button>
                     </children>
                  </HBox>
                  <HBox fx:id="fpsPanel" alignment="CENTER_LEFT" minHeight="30.0" spacing="12.0">
                     <children>
                        <Label minWidth="150.0" prefWidth="150.0" styleClass="sm-text" text="%recorder.screen.fps" />
                        <CheckBox fx:id="fps60Checkbox" mnemonicParsing="false" styleClass="sm-text" text="%recorder.screen_recorder_panel.record_with_60fps" />
                     </children>
                  </HBox>
                  <HBox fx:id="rotationPanel" alignment="CENTER_LEFT" minHeight="30.0" spacing="12.0">
                     <children>
                        <Label minWidth="150.0" prefWidth="150.0" styleClass="sm-text" text="%recorder.screen.orientation" />
                        <CheckBox fx:id="rotationCheckbox" mnemonicParsing="false" styleClass="sm-text" text="%recorder.screen_recorder_panel.180_rotation" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- live preview of the screen, hidden when the card is too narrow -->
            <VBox fx:id="preview" minWidth="0.0" prefWidth="0.0" spacing="8.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="sm-caption" text="%recorder.screen.caption_preview" />
                  <StackPane fx:id="previewBox" minHeight="140.0" minWidth="0.0" styleClass="sm-inset">
                     <children>
                        <ImageView fx:id="imageView" pickOnBounds="true" preserveRatio="true" />
                     </children>
                     <padding>
                        <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                     </padding>
                  </StackPane>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
         </padding>
      </HBox>
   </children>
</VBox>
