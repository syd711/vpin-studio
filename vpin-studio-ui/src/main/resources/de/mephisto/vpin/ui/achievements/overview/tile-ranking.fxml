<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="Infinity" maxWidth="Infinity" prefWidth="100.0" spacing="8.0" styleClass="sm-tile" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.achievements.overview.OverviewRankingTileController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: -c-white;" text="%widgets.widget_player_rank.player_ranking" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" styleClass="sm-segmented">
               <children>
                  <ToggleButton fx:id="cabinetBtn" mnemonicParsing="false" onAction="#onCabinet" selected="true" text="%achievements.cabinet">
                     <toggleGroup>
                        <ToggleGroup fx:id="rankingGroup" />
                     </toggleGroup>
                  </ToggleButton>
                  <ToggleButton fx:id="cloudBtn" mnemonicParsing="false" onAction="#onCloud" text="%achievements.cloud" toggleGroup="$rankingGroup" />
               </children>
            </HBox>
         </children>
      </HBox>
      <VBox VBox.vgrow="ALWAYS">
         <children>
            <!-- the widget title is hidden by the controller -->
            <fx:include fx:id="playerRank" source="/de/mephisto/vpin/commons/fx/widgets/widget-player-rank.fxml" VBox.vgrow="ALWAYS" />
            <VBox fx:id="cloudBox" managed="false" visible="false" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
</VBox>
