<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="settingsPane" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.cards.panels.LayerEditorScoresController">
   <graphic>
      <BorderPane prefWidth="250.0">
         <left>
            <Label text="%cards.template_editor_scores.score_settings" />
         </left>
         <right>
             <HBox alignment="CENTER_RIGHT" spacing="3.0">
                 <children>
                     <Button fx:id="eyeBtn" mnemonicParsing="false">
                         <font>
                             <Font size="10.0" />
                         </font>
                         <graphic>
                             <FontIcon iconColor="WHITE" iconLiteral="mdi2e-eye-outline" />
                         </graphic>
                         <tooltip>
                             <Tooltip text="%cards.template_editor_scores.toggle_scores_visibility" />
                         </tooltip>
                     </Button>
                     <ToggleButton fx:id="lockBtn" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onLockToggle" styleClass="custom-toggle-button-small">
                         <font>
                             <Font size="10.0" />
                         </font>
                         <graphic>
                             <FontIcon iconColor="WHITE" iconLiteral="mdi2l-lock-open-variant-outline" iconSize="13" />
                         </graphic>
                         <tooltip>
                             <Tooltip text="%cards.template_editor_background.lock_these_properties_for_custom_templates" />
                         </tooltip>
                     </ToggleButton>
                 </children>
             </HBox>
         </right>
      </BorderPane>
   </graphic>
   <content>
      <ScrollPane hbarPolicy="NEVER">
         <content>
            <VBox styleClass="accordion-container">
              <children>
                <Label text="%cards.template_editor_scores.score_font" textFill="WHITE">
                    <font>
                      <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <BorderPane>
                    <left>
                      <Label fx:id="scoreFontLabel" prefWidth="150.0" textFill="WHITE" BorderPane.alignment="CENTER">
                          <font>
                            <Font size="14.0" />
                          </font>
                      </Label>
                    </left>
                    <right>
                      <HBox spacing="3.0" BorderPane.alignment="CENTER">
                          <children>
                            <Button mnemonicParsing="false" onAction="#onFontScoreSelect">
                                <font>
                                  <Font size="14.0" />
                                </font>
                                <graphic>
                                  <FontIcon iconColor="WHITE" iconLiteral="bi-fonts" />
                                </graphic>
                            </Button>
                            <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onFontScoreApplyAll">
                                <font>
                                  <Font size="14.0" />
                                </font>
                                <graphic>
                                  <FontIcon iconColor="WHITE" iconLiteral="mdi2c-check-all" />
                                </graphic>
                                <tooltip>
                                  <Tooltip text="%cards.template_editor_scores.apply_selected_font_settings_to_all_templates" />
                                </tooltip>
                            </Button>
                          </children>
                      </HBox>
                    </right>
                </BorderPane>

                <Label text="%cards.template_editor_scores.font_color" textFill="WHITE">
                    <font>
                      <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                      <Insets top="12.0" />
                    </VBox.margin>
                </Label>
                <ColorPicker fx:id="fontColorSelector">
                    <VBox.margin>
                      <Insets top="6.0" />
                    </VBox.margin>
                </ColorPicker>

                <Label text="%cards.template_editor_scores.font_color_for_friends" textFill="WHITE">
                    <font>
                      <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                      <Insets top="6.0" />
                    </VBox.margin>
                </Label>
                <ColorPicker fx:id="friendsFontColorSelector">
                    <VBox.margin>
                      <Insets bottom="12.0" top="6.0" />
                    </VBox.margin>
                </ColorPicker>

                <fx:include fx:id="position" source="template-subeditor-position.fxml" />

                <HBox alignment="BASELINE_LEFT" spacing="6.0">
                    <children>
                      <Label text="%cards.template_editor_scores.row_separator" textFill="WHITE">
                          <font>
                            <Font size="14.0" />
                          </font>
                      </Label>
                      <Label>
                          <graphic>
                            <FontIcon iconColor="WHITE" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                          </graphic>
                          <tooltip>
                            <Tooltip text="%cards.template_editor_scores.the_vertical_space_between_the_lines_of_the" />
                          </tooltip>
                      </Label>
                    </children>
                    <VBox.margin>
                      <Insets top="12.0" />
                    </VBox.margin>
                </HBox>
                <Spinner fx:id="rowSeparatorSpinner" editable="true" prefWidth="70" styleClass="widget-default">
                    <VBox.margin>
                      <Insets top="6.0" />
                    </VBox.margin>
                </Spinner>

                <HBox alignment="BASELINE_LEFT" spacing="6.0">
                    <children>
                      <CheckBox fx:id="renderRawHighscore" mnemonicParsing="false" text="%cards.template_editor_scores.render_raw_highscore_data" textFill="WHITE">
                          <font>
                            <Font size="14.0" />
                          </font>
                      </CheckBox>
                      <Label>
                          <graphic>
                            <FontIcon iconColor="WHITE" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                          </graphic>
                          <tooltip>
                            <Tooltip text="%cards.template_editor_scores.the_font_size_of_the_highscore_text_will" />
                          </tooltip>
                      </Label>
                    </children>
                    <VBox.margin>
                      <Insets top="12.0" />
                    </VBox.margin>
                </HBox>
                  <HBox alignment="BASELINE_LEFT" layoutX="22.0" layoutY="417.0" spacing="6.0">
                     <children>
                        <CheckBox fx:id="renderNamesHighscore" mnemonicParsing="false" text="%cards.template_editor_scores.render_names" textFill="WHITE">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                        <Label>
                           <graphic>
                              <FontIcon iconColor="WHITE" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                           </graphic>
                           <tooltip>
                              <Tooltip text="%cards.template_editor_scores.when_selected_the_display_names_of_the_player" />
                           </tooltip>
                        </Label>
                     </children>
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                  </HBox>

                <HBox alignment="BASELINE_LEFT" spacing="6.0">
                    <children>
                      <CheckBox fx:id="renderFriendsHighscore" mnemonicParsing="false" text="%cards.template_editor_scores.render_friends_highscore_data" textFill="WHITE">
                          <font>
                            <Font size="14.0" />
                          </font>
                      </CheckBox>
                      <Label>
                          <graphic>
                            <FontIcon iconColor="WHITE" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                          </graphic>
                          <tooltip>
                            <Tooltip text="%cards.template_editor_scores.the_scores_of_your_friends_will_be_merged" />
                          </tooltip>
                      </Label>
                    </children>
                    <VBox.margin>
                      <Insets top="12.0" />
                    </VBox.margin>
                </HBox>

                <HBox alignment="BASELINE_LEFT" spacing="6.0">
                    <children>
                      <Label text="%cards.template_editor_scores.max_scores" textFill="WHITE">
                          <font>
                            <Font size="14.0" />
                          </font>
                      </Label>
                      <Label>
                          <graphic>
                            <FontIcon iconColor="WHITE" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                          </graphic>
                          <tooltip>
                            <Tooltip text="%cards.template_editor_scores.0_will_render_all_available_scores" />
                          </tooltip>
                      </Label>
                    </children>
                    <VBox.margin>
                      <Insets left="26.0" top="12.0" />
                    </VBox.margin>
                </HBox>
                <Spinner fx:id="maxScoresSpinner" editable="true" prefWidth="70.0" styleClass="widget-default">
                    <VBox.margin>
                      <Insets left="26.0" top="6.0" />
                    </VBox.margin>
                </Spinner>

                <CheckBox fx:id="renderPositionsCheckbox" mnemonicParsing="false" text="%cards.template_editor_scores.render_positions" textFill="WHITE">
                    <font>
                      <Font size="14.0" />
                    </font>
                    <VBox.margin>
                      <Insets left="26.0" top="6.0" />
                    </VBox.margin>
                </CheckBox>

                <CheckBox fx:id="renderScoreDatesCheckbox" mnemonicParsing="false" text="%cards.template_editor_scores.render_creation_dates" textFill="WHITE">
                    <font>
                      <Font size="14.0" />
                    </font>
                    <VBox.margin>
                      <Insets left="26.0" top="6.0" />
                    </VBox.margin>
                </CheckBox>

              </children>
              <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
              </padding>
            </VBox>
         </content>
      </ScrollPane>
   </content>
</TitledPane>
