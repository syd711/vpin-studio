<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.preferences.McpPreferencesController">
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" BorderPane.alignment="CENTER">
         <content>
            <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="850.0" spacing="6.0" styleClass="subpanel">
               <children>
                  <Label styleClass="preference-title, c-text-white" text="%pref.mcp.title" />
                  <Label maxWidth="620.0" styleClass="preference-description, c-text-white" text="%pref.mcp.description" wrapText="true" />

                  <Label styleClass="preference-subtitle" text="%pref.mcp.server">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                  </Label>
                  <CheckBox fx:id="enabledCheckbox" styleClass="c-text-white" text="%pref.mcp.enabled">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </CheckBox>
                  <Label maxWidth="620.0" styleClass="checkbox-description, c-text-white" text="%pref.mcp.enabled_description" wrapText="true" />

                  <VBox fx:id="connectionPanel" spacing="6.0">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                     <children>
                        <CheckBox fx:id="readOnlyCheckbox" text="%pref.mcp.read_only" styleClass="c-text-white">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                        <Label maxWidth="620.0" styleClass="checkbox-description, c-text-white" text="%pref.mcp.read_only_description" wrapText="true" />

                        <VBox fx:id="groupsPanel" spacing="6.0">
                           <VBox.margin>
                              <Insets left="24.0" top="6.0" />
                           </VBox.margin>
                           <children>
                              <Label styleClass="sm-small" text="%pref.mcp.groups" />
                              <Label maxWidth="596.0" styleClass="preference-description, c-text-white" text="%pref.mcp.groups_description" wrapText="true" />
                              <CheckBox fx:id="tablesCheckbox" styleClass="c-text-white" text="%pref.mcp.group.tables">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </CheckBox>
                              <Label maxWidth="596.0" styleClass="checkbox-description, c-text-white" text="%pref.mcp.group.tables_description" wrapText="true" />
                              <CheckBox fx:id="competitionsCheckbox" styleClass="c-text-white" text="%pref.mcp.group.competitions">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </CheckBox>
                              <Label maxWidth="596.0" styleClass="checkbox-description, c-text-white" text="%pref.mcp.group.competitions_description" wrapText="true" />
                              <CheckBox fx:id="playlistsCheckbox" styleClass="c-text-white" text="%pref.mcp.group.playlists">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </CheckBox>
                              <Label maxWidth="596.0" styleClass="checkbox-description, c-text-white" text="%pref.mcp.group.playlists_description" wrapText="true" />
                              <CheckBox fx:id="mediaCheckbox" styleClass="c-text-white" text="%pref.mcp.group.media">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </CheckBox>
                              <Label maxWidth="596.0" styleClass="checkbox-description, c-text-white" text="%pref.mcp.group.media_description" wrapText="true" />
                              <CheckBox fx:id="settingsCheckbox" styleClass="c-text-white" text="%pref.mcp.group.settings">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </CheckBox>
                              <Label maxWidth="596.0" styleClass="checkbox-description, c-text-white" text="%pref.mcp.group.settings_description" wrapText="true" />
                              <CheckBox fx:id="systemCheckbox" styleClass="c-text-white" text="%pref.mcp.group.system">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </CheckBox>
                              <Label maxWidth="596.0" styleClass="checkbox-description, c-text-white" text="%pref.mcp.group.system_description" wrapText="true" />
                           </children>
                        </VBox>

                        <Label styleClass="sm-small" text="%pref.mcp.url">
                           <VBox.margin>
                              <Insets top="12.0" />
                           </VBox.margin>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <TextField fx:id="urlText" editable="false" prefWidth="560.0" styleClass="sm-text-field" />
                              <Button mnemonicParsing="false" onAction="#onCopyUrl" styleClass="sm-button, sm-button-icon">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2c-content-copy" iconSize="18" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%pref.mcp.copy" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>


                        <Label styleClass="preference-subtitle" text="%pref.mcp.claude_code">
                           <VBox.margin>
                              <Insets top="12.0" />
                           </VBox.margin>
                        </Label>
                        <Label maxWidth="620.0" styleClass="preference-description, c-text-white" text="%pref.mcp.claude_code_description" wrapText="true" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <TextField fx:id="commandText" editable="false" prefWidth="560.0" styleClass="sm-text-field" />
                              <Button mnemonicParsing="false" onAction="#onCopyCommand" styleClass="sm-button, sm-button-icon">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2c-content-copy" iconSize="18" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%pref.mcp.copy" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                        <Label maxWidth="620.0" text="%pref.mcp.host_hint" wrapText="true">
                           <styleClass>
                              <String fx:value="preference-description" />
                              <String fx:value="c-text-white" />
                           </styleClass></Label>

                        <Label styleClass="preference-subtitle" text="%pref.mcp.tools">
                           <VBox.margin>
                              <Insets top="12.0" />
                           </VBox.margin>
                        </Label>
                        <Label maxWidth="620.0" styleClass="preference-description, c-text-white" text="%pref.mcp.tools_description" wrapText="true" />

                        <Label styleClass="preference-subtitle" text="%pref.mcp.audit">
                           <VBox.margin>
                              <Insets top="12.0" />
                           </VBox.margin>
                        </Label>
                        <Label maxWidth="620.0" styleClass="preference-description, c-text-white" text="%pref.mcp.audit_description" wrapText="true" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onAuditRefresh" styleClass="sm-button, sm-button-icon">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2r-refresh" iconSize="18" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%pref.mcp.audit.refresh" />
                                 </tooltip>
                              </Button>
                              <Pane HBox.hgrow="ALWAYS" />
                              <Button fx:id="auditClearBtn" mnemonicParsing="false" onAction="#onAuditClear" styleClass="sm-button" text="%pref.mcp.audit.clear" />
                           </children>
                        </HBox>
                        <TableView fx:id="auditTable" prefHeight="300.0" prefWidth="800.0">
                           <columns>
                              <TableColumn fx:id="auditTimeColumn" prefWidth="130.0" text="%pref.mcp.audit.time" />
                              <TableColumn fx:id="auditToolColumn" prefWidth="170.0" text="%pref.mcp.audit.tool" />
                              <TableColumn fx:id="auditStatusColumn" prefWidth="100.0" text="%pref.mcp.audit.status" />
                              <TableColumn fx:id="auditArgumentsColumn" prefWidth="190.0" text="%pref.mcp.audit.arguments" />
                              <TableColumn fx:id="auditResultColumn" prefWidth="200.0" text="%pref.mcp.audit.result" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
