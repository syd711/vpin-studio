<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.preferences.AchievementsPreferencesController">
   <center>
      <ScrollPane hbarPolicy="NEVER" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="preference-title" text="%pref.achievements.title" textFill="WHITE" />
                  <Label styleClass="preference-description" text="%pref.achievements.description" textFill="WHITE" wrapText="true" maxWidth="620.0" />

                  <Label styleClass="preference-subtitle" text="%pref.achievements.tracking">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                  </Label>
                  <CheckBox fx:id="enabledCheckbox" styleClass="preference-checkbox" text="%pref.achievements.enabled" textFill="WHITE" />
                  <CheckBox fx:id="notificationsCheckbox" styleClass="preference-checkbox" text="%pref.achievements.notifications" textFill="WHITE" />
                  <CheckBox fx:id="cloudCheckbox" styleClass="preference-checkbox" text="%pref.achievements.cloud" textFill="WHITE" />
                  <Label styleClass="preference-description" text="%pref.achievements.cloud_description" textFill="WHITE" wrapText="true" maxWidth="620.0" />

                  <Label styleClass="preference-subtitle" text="%pref.achievements.players">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                  </Label>
                  <Label styleClass="preference-description" text="%pref.achievements.players_description" textFill="WHITE" wrapText="true" maxWidth="620.0" />
                  <VBox fx:id="playersBox" spacing="4.0" />

                  <Label styleClass="preference-subtitle" text="%pref.achievements.migration">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                  </Label>
                  <Label styleClass="preference-description" text="%pref.achievements.migration_description" textFill="WHITE" wrapText="true" maxWidth="620.0" />
                  <Button mnemonicParsing="false" onAction="#onMigrate" text="%pref.achievements.migrate">
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2c-cloud-download-outline" iconSize="18" />
                     </graphic>
                     <VBox.margin>
                        <Insets top="6.0" />
                     </VBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets right="12.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
