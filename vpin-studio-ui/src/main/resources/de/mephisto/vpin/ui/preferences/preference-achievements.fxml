<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.preferences.AchievementsPreferencesController">
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" BorderPane.alignment="CENTER">
         <content>
            <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="850.0" spacing="6.0" styleClass="subpanel">
               <children>
                  <Label styleClass="preference-title, c-text-white" text="%pref.achievements.title" />
                  <Label maxWidth="620.0" styleClass="preference-description, c-text-white" text="%pref.achievements.description" wrapText="true" />
                  <VBox spacing="3.0">
                     <children>
      
                        <Label styleClass="preference-subtitle" text="%pref.achievements.tracking">
                           <VBox.margin>
                              <Insets bottom="12.0" />
                           </VBox.margin></Label>
                        <CheckBox fx:id="enabledCheckbox" text="%pref.achievements.enabled" styleClass="c-text-white">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="cloudCheckbox" text="%pref.achievements.cloud" styleClass="c-text-white">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                        <Label maxWidth="620.0" styleClass="checkbox-description, c-text-white" text="%pref.achievements.cloud_description" wrapText="true" />
                     </children>
                  </VBox>

                  <Label styleClass="preference-subtitle" text="%pref.achievements.live">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                  </Label>
                  <Label maxWidth="620.0" styleClass="preference-description, c-text-white" text="%pref.achievements.live_description" wrapText="true" />
                  <CheckBox fx:id="liveCheckbox" text="%pref.achievements.live_enabled" styleClass="c-text-white">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </CheckBox>
                  <Label maxWidth="620.0" styleClass="checkbox-description, c-text-white" text="%pref.achievements.live_enabled_description" wrapText="true" />
                  <VBox spacing="3.0">
                     <VBox.margin>
                        <Insets top="6.0" />
                     </VBox.margin>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Button fx:id="liveInstallBtn" mnemonicParsing="false" onAction="#onLiveInstall" text="%pref.achievements.live_install">
                                 <graphic>
                                    <FontIcon styleClass="c-icon-white" iconLiteral="mdi2d-download" iconSize="18" />
                                 </graphic>
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
                              <Button fx:id="liveUpdateVpxBtn" mnemonicParsing="false" onAction="#onLiveUpdateVpx" text="%pref.achievements.live_update_vpx">
                                 <graphic>
                                    <FontIcon styleClass="c-icon-white" iconLiteral="mdi2u-update" iconSize="18" />
                                 </graphic>
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
                              <Button fx:id="liveOpenFolderBtn" mnemonicParsing="false" onAction="#onLiveOpenFolder" text="%pref.achievements.live_open_folder">
                                 <graphic>
                                    <FontIcon styleClass="c-icon-white" iconLiteral="mdi2f-folder-open" iconSize="18" />
                                 </graphic>
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
                              <Button fx:id="liveUninstallBtn" mnemonicParsing="false" onAction="#onLiveUninstall" text="%pref.achievements.live_uninstall">
                                 <graphic>
                                    <FontIcon styleClass="c-icon-danger" iconLiteral="mdi2d-delete-outline" iconSize="18" />
                                 </graphic>
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
                           </children>
                        </HBox>
                        <Label fx:id="liveStatusLabel" maxWidth="480.0" styleClass="c-text-muted" wrapText="true">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>

                  <Label styleClass="preference-subtitle" text="%pref.achievements.players">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                  </Label>
                  <Label maxWidth="620.0" styleClass="preference-description, c-text-white" text="%pref.achievements.players_description" wrapText="true" />
                  <VBox fx:id="playersBox" spacing="4.0" />

                  <Label styleClass="preference-subtitle" text="%pref.achievements.migration">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                  </Label>
                  <Label maxWidth="620.0" styleClass="preference-description, c-text-white" text="%pref.achievements.migration_description" wrapText="true" />
                  <Button mnemonicParsing="false" onAction="#onMigrate" text="%pref.achievements.migrate">
                     <graphic>
                        <FontIcon styleClass="c-icon-white" iconLiteral="mdi2c-cloud-download-outline" iconSize="18" />
                     </graphic>
                     <VBox.margin>
                        <Insets top="6.0" />
                     </VBox.margin>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
