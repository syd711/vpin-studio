<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="8.0" style="-fx-background-color: #2A2A2A; -fx-background-radius: 6;" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.achievements.tables.TableSummaryTileController">
   <children>
      <HBox alignment="CENTER_LEFT" maxHeight="112.0" minHeight="112.0" prefHeight="112.0" spacing="18.0">
         <children>
            <StackPane fx:id="wheelBox" maxHeight="112.0" maxWidth="112.0" minHeight="112.0" minWidth="112.0" prefHeight="112.0" prefWidth="112.0" />
            <VBox spacing="3.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="nameLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
                  <Label fx:id="metaLabel" style="-fx-font-size: 14px; -fx-text-fill: #BDBDBD;" />
               </children>
            </VBox>
            <VBox fx:id="progressBox" minWidth="260.0" spacing="6.0">
               <children>
                  <HBox spacing="8.0">
                     <children>
                        <Label fx:id="countLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="pctLabel" style="-fx-font-size: 14px; -fx-text-fill: #DD9646; -fx-font-weight: bold;" />
                     </children>
                  </HBox>
                  <StackPane fx:id="progressBarBox" />
                  <HBox fx:id="distributionBox" spacing="10.0" />
               </children>
            </VBox>
            <VBox fx:id="buttonsBox" alignment="CENTER" spacing="6.0">
               <children>
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onOpen" text="%achievements.open_in_tables">
                     <font>
                        <Font size="14.0" />
                     </font></Button>
                  <Button fx:id="sessionsBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#onSessions" text="%achievements.played_games">
                     <font>
                        <Font size="14.0" />
                     </font></Button>
                  <Button fx:id="leaderboardBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#onLeaderboard" text="%achievements.show_leaderboard">
                     <font>
                        <Font size="14.0" />
                     </font></Button>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
</VBox>
