<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="5.0" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.tables.alx.AlxBarEntryController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Label fx:id="titleLabel" maxWidth="1.7976931348623157E308" minWidth="0.0" styleClass="sm-text" text="-" HBox.hgrow="ALWAYS" />
            <Label fx:id="valueLabel" minWidth="-Infinity" styleClass="sm-text-bold" text="-" />
         </children>
      </HBox>
      <Label fx:id="subLabel" managed="false" styleClass="sm-hint" text="-" visible="false" />
      <StackPane fx:id="barStack" alignment="CENTER_LEFT" maxHeight="8.0" minHeight="8.0" minWidth="0.0" prefHeight="8.0" styleClass="sm-bar-track">
         <children>
            <Region fx:id="bar" maxHeight="8.0" minHeight="8.0" prefHeight="8.0" styleClass="sm-bar" />
         </children>
      </StackPane>
   </children>
   <padding>
      <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
   </padding>
</VBox>
