<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="12.0" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.cards.panels.LayerSubEditorPositionController">
   <children>
      <GridPane hgap="12.0" vgap="12.0">
         <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" minWidth="80.0" percentWidth="50.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="80.0" percentWidth="50.0" />
         </columnConstraints>
         <children>
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="sm-small" text="%cards.template_editor_wheel.position_x" />
                  <Spinner fx:id="xSpinner" editable="true" maxWidth="1.7976931348623157E308" />
               </children>
            </VBox>
            <VBox spacing="6.0" GridPane.columnIndex="1">
               <children>
                  <Label styleClass="sm-small" text="%cards.template_editor_wheel.position_y" />
                  <Spinner fx:id="ySpinner" editable="true" maxWidth="1.7976931348623157E308" />
               </children>
            </VBox>
            <VBox spacing="6.0" GridPane.rowIndex="1">
               <children>
                  <Label styleClass="sm-small" text="%cards.template_subeditor_position.width" />
                  <Spinner fx:id="widthSpinner" editable="true" maxWidth="1.7976931348623157E308" />
               </children>
            </VBox>
            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Label styleClass="sm-small" text="%cards.template_subeditor_position.height" />
                  <Spinner fx:id="heightSpinner" editable="true" maxWidth="1.7976931348623157E308" />
               </children>
            </VBox>
         </children>
      </GridPane>

      <VBox fx:id="alignBox" spacing="6.0">
         <children>
            <Label styleClass="sm-small" text="%cards.designer.align" />
            <HBox spacing="10.0">
               <children>
                  <HBox styleClass="sm-segmented">
                     <children>
                        <ToggleButton fx:id="alignLeftButton" mnemonicParsing="false">
                           <tooltip>
                              <Tooltip text="%cards.template_subeditor_position.align_content_on_left" />
                           </tooltip>
                           <graphic>
                              <FontIcon iconLiteral="mdi2a-align-horizontal-left" iconSize="16" />
                           </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="alignCenterButton" mnemonicParsing="false">
                           <tooltip>
                              <Tooltip text="%cards.template_subeditor_position.center_content_horizontally" />
                           </tooltip>
                           <graphic>
                              <FontIcon iconLiteral="mdi2a-align-horizontal-center" iconSize="16" />
                           </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="alignRightButton" mnemonicParsing="false">
                           <tooltip>
                              <Tooltip text="%cards.template_subeditor_position.align_content_on_right" />
                           </tooltip>
                           <graphic>
                              <FontIcon iconLiteral="mdi2a-align-horizontal-right" iconSize="16" />
                           </graphic>
                        </ToggleButton>
                     </children>
                  </HBox>
                  <HBox styleClass="sm-segmented">
                     <children>
                        <ToggleButton fx:id="alignTopButton" mnemonicParsing="false">
                           <tooltip>
                              <Tooltip text="%cards.template_subeditor_position.align_content_on_top" />
                           </tooltip>
                           <graphic>
                              <FontIcon iconLiteral="mdi2a-align-vertical-top" iconSize="16" />
                           </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="alignMiddleButton" mnemonicParsing="false">
                           <tooltip>
                              <Tooltip text="%cards.template_subeditor_position.center_content_vertically" />
                           </tooltip>
                           <graphic>
                              <FontIcon iconLiteral="mdi2a-align-vertical-center" iconSize="16" />
                           </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="alignBottomButton" mnemonicParsing="false">
                           <tooltip>
                              <Tooltip text="%cards.template_subeditor_position.align_content_on_bottom" />
                           </tooltip>
                           <graphic>
                              <FontIcon iconLiteral="mdi2a-align-vertical-bottom" iconSize="16" />
                           </graphic>
                        </ToggleButton>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
