<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" styleClass="main" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.mania.ManiaSettingsController">
   <center>
      <HBox alignment="TOP_CENTER" BorderPane.alignment="TOP_CENTER">
         <children>
            <BorderPane>
               <center>
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="pref-nav">
                     <content>
                        <VBox fx:id="navigationBox" spacing="2.0">
                           <children>
                              <VBox fx:id="maniaGroup" spacing="2.0">
                                 <children>
                                    <Label alignment="BASELINE_LEFT" layoutX="10.0" layoutY="10.0" styleClass="preference-section" text="%mania.mania_preferences.cabinet">
                                    </Label>
                                    <Button fx:id="initialButton" alignment="BASELINE_LEFT" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#onAccount" styleClass="preference-button" text="%mania.mania_preferences.cabinet_settings" />
                                 </children>
                              </VBox>
                              <VBox fx:id="menuItemsPanel" spacing="2.0">
                                 <children>
                                    <Button alignment="BASELINE_LEFT" contentDisplay="RIGHT" mnemonicParsing="false" fx:id="privacySettingsBtn" onAction="#onPrivacySettings" styleClass="preference-button" text="%mania.mania_preferences.data_privacy_settings" />
                                    <Button alignment="BASELINE_LEFT" contentDisplay="RIGHT" mnemonicParsing="false" fx:id="discordSettingsBtn" onAction="#onDiscordSettings" styleClass="preference-button" text="%mania.mania_preferences.discord_settings" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </center>
               <HBox.margin>
                  <Insets top="24.0" />
               </HBox.margin>
               <bottom>
                  <VBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
                     <BorderPane.margin>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                     </BorderPane.margin>
                     <children>
                        <Hyperlink fx:id="kofiLink" onAction="#onKofiLink">
                           <graphic>
                              <FontIcon styleClass="c-icon-warm-gray-light" iconLiteral="mdi-discord" iconSize="24" />
                           </graphic>
                        </Hyperlink>
                        <Hyperlink onAction="#onDiscordLink" text="%mania.mania_preferences.join_discord">
                           <graphic>
                              <FontIcon styleClass="c-icon-warm-gray-light" iconLiteral="mdi-discord" iconSize="24" />
                           </graphic>
                        </Hyperlink>
                        <Hyperlink fx:id="versionLink" onAction="#onVersionLInk" styleClass="version-label, c-text-warm-gray" text="%competitions.discord_competition_edit.hyperlink" />
                        <Label fx:id="hostLabel" layoutX="358.0" layoutY="10.0" styleClass="version-label" text="%competitions.discord_competition_edit.label">
                           <VBox.margin>
                              <Insets right="5.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
               </bottom>
            </BorderPane>
            <BorderPane>
               <left>
                  <BorderPane fx:id="preferencesMain" maxWidth="900.0" minWidth="900.0" prefWidth="900.0" styleClass="subpanel" BorderPane.alignment="CENTER">
                     <BorderPane.margin>
                        <Insets bottom="12.0" left="12.0" top="24.0" />
                     </BorderPane.margin>
                     <center>
                     </center>
                  </BorderPane>
               </left>
               <right>
                  <HBox BorderPane.alignment="CENTER">
                     <BorderPane.margin>
                        <Insets top="28.0" />
                     </BorderPane.margin>
                     <children>
                        <Button mnemonicParsing="false" onAction="#onClose" styleClass="ghost-button-default">
                           <graphic>
                              <FontIcon styleClass="c-icon-white" iconLiteral="mdi2c-close-circle-outline" iconSize="48" />
                           </graphic>
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
               </right>
            </BorderPane>
         </children>
      </HBox>
   </center>
</BorderPane>
