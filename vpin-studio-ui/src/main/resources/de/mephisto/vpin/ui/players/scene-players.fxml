<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.players.PlayersController">

   <center>
      <VBox spacing="14.0" BorderPane.alignment="CENTER">
         <children>
            <BorderPane fx:id="playersRoot" VBox.vgrow="ALWAYS" />
            <HBox fx:id="validationError" spacing="12.0" styleClass="sm-alert">
               <children>
                  <StackPane maxHeight="24.0" maxWidth="24.0" minHeight="24.0" minWidth="24.0" styleClass="sm-alert-icon">
                     <children>
                        <FontIcon styleClass="c-icon-white" iconLiteral="mdi2e-exclamation-thick" iconSize="14" />
                     </children>
                  </StackPane>
                  <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="errorTitleLabel" text="%players.players.duplicate_initials" styleClass="sm-alert-title" wrapText="true" />
                        <Label fx:id="errorTextLabel" styleClass="sm-alert-text" wrapText="true" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
               </padding>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets right="14.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   <right>
      <!-- fixed width: score widget (600) + scroll bar + horizontal padding (32) + border (2) -->
      <VBox minWidth="648.0" prefWidth="648.0" maxWidth="648.0" spacing="14.0" styleClass="sm-tile, sm-tile-bordered" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="highscoresCaptionLabel" text="%players.players.highscores_caption" styleClass="sm-caption" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label fx:id="playerScoreLabel" text="%players.players.player_highscores" style="-fx-font-size: 20px; -fx-font-weight: bold;" styleClass="c-text-white" />
                              <Label fx:id="scoreCountLabel" styleClass="sm-pill, sm-pill-unknown" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <CheckBox fx:id="loadScoreList" mnemonicParsing="false" text="%players.players.load_score_list" styleClass="sm-text" />
               </children>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sm-transparent-scroll" VBox.vgrow="ALWAYS">
               <content>
                  <VBox spacing="10.0">
                     <children>
                        <Label fx:id="noScoreLabel" text="%players.players.no_highscores_found_for_this_player" styleClass="sm-hint" wrapText="true" />
                        <VBox fx:id="highscoreList" spacing="4.0" />
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
         </padding>
      </VBox>
   </right>
   <padding>
      <Insets bottom="12.0" right="12.0" />
   </padding>
</BorderPane>
