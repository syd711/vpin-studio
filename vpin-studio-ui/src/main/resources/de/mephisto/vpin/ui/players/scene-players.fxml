<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.players.PlayersController">

    <center>
        <BorderPane styleClass="subpanel" BorderPane.alignment="CENTER">
            <center>
                <BorderPane fx:id="playersRoot" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets left="12.0" right="12.0" top="12.0" />
                    </BorderPane.margin>
                </BorderPane>
            </center>
         <BorderPane.margin>
            <Insets right="12.0" />
         </BorderPane.margin>
         <bottom>
            <BorderPane BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </BorderPane.margin>
               <center>
                  <BorderPane fx:id="validationError" styleClass="sm-alert">
                     <center>
                        <HBox spacing="12.0">
                           <children>
                              <StackPane maxHeight="24.0" maxWidth="24.0" minHeight="24.0" minWidth="24.0" styleClass="sm-alert-icon">
                                 <children>
                                    <FontIcon styleClass="c-icon-white" iconLiteral="mdi2e-exclamation-thick" iconSize="14" />
                                 </children>
                              </StackPane>
                              <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="errorTitleLabel" text="%players.players.duplicate_initials" styleClass="sm-alert-title" wrapText="true" />
                                    <Label fx:id="errorTextLabel" styleClass="sm-alert-text" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </center>
                     <padding>
                        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                     </padding>
                  </BorderPane>
               </center>
               <top>
                  <Label fx:id="playerCountLabel" text="%competitions.discord_competition_edit.label" BorderPane.alignment="TOP_RIGHT" />
               </top>
            </BorderPane>
         </bottom>
        </BorderPane>
    </center>
   <right>
      <VBox prefWidth="600.0" styleClass="subpanel" BorderPane.alignment="CENTER">
         <children>
            <TitledPane fx:id="highscoresTitledPane" animated="false" styleClass="c-text-white">
               <font>
                  <Font size="14.0" />
               </font>
               <content>
                  <ScrollPane hbarPolicy="NEVER" maxHeight="1.7976931348623157E308">
                     <content>
                        <BorderPane>
                           <center>
                              <VBox fx:id="highscoreList" spacing="6.0" />
                           </center>
                           <top>
                              <Label fx:id="noScoreLabel" text="%players.players.no_highscores_found_for_this_player" styleClass="c-text-white" BorderPane.alignment="TOP_LEFT">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                                 <BorderPane.margin>
                                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                 </BorderPane.margin>
                              </Label>
                           </top>
                        </BorderPane>
                     </content>
                  </ScrollPane>
               </content>
               <graphic>
                  <BorderPane prefWidth="550.0">
                     <left>
                        <Label fx:id="playerScoreLabel" text="%players.players.player_highscores" BorderPane.alignment="CENTER" />
                     </left>
                     <right>
                        <CheckBox fx:id="loadScoreList" mnemonicParsing="false" text="%players.players.load_score_list" BorderPane.alignment="CENTER">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </CheckBox>
                     </right>
                  </BorderPane>
               </graphic>
            </TitledPane>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </right>
   <padding>
      <Insets bottom="12.0" right="12.0" />
   </padding>
</BorderPane>
