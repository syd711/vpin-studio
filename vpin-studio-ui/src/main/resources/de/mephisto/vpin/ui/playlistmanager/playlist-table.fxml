<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" styleClass="base-component" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.playlistmanager.PlaylistTableController">
   <center>
      <StackPane fx:id="tableStack" style="-fx-background-color: #222222;" BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="tableView" onMouseClicked="#onTableMouseClicked" style="-fx-background-color: #2a2a2a;" styleClass="base-component">
               <columns>
                  <TableColumn fx:id="columnName" minWidth="100.0" prefWidth="350.0" style="-fx-alignment: BASELINE_LEFT;" text="%backups.backups.name" />
                  <TableColumn fx:id="columnEmulator" minWidth="10.4000244140625" prefWidth="200.0" sortable="false" style="-fx-alignment: BASELINE_LEFT;" text="%backglass.directb2s_admin.emulator" />
                  <TableColumn fx:id="columnDateAdded" minWidth="10.4000244140625" prefWidth="140.2000732421875" style="-fx-alignment: CENTER;" text="%playlistmanager.playlist_table.date_added" />
                  <TableColumn fx:id="columnDateModified" minWidth="10.4000244140625" prefWidth="140.2000732421875" style="-fx-alignment: CENTER;" text="%playlistmanager.playlist_table.last_update" />
               </columns>
            </TableView>
         </children>
      </StackPane>
   </center>
   <top>
      <ToolBar>
         <items>
            <StackPane alignment="CENTER_RIGHT">
               <children>
                  <TextField fx:id="searchTextField" onKeyPressed="#onSearchKeyPressed" prefHeight="30.0" prefWidth="200.0" promptText="%cards.highscore_cards.search_table">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </TextField>
                  <Button fx:id="clearBtn" mnemonicParsing="false" onAction="#onClear" styleClass="ghost-icon-button" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconColor="#222222" iconLiteral="mdi2c-close-thick" iconSize="18" />
                     </graphic>
                  </Button>
               </children>
            </StackPane>
            <Separator orientation="VERTICAL" prefHeight="0.0" prefWidth="12.0" />
            <ComboBox fx:id="allEmulatorsCombo" prefWidth="150.0" promptText="%playlistmanager.playlist_table.all_emulators" />
            <Separator fx:id="emulatorsSeparator" layoutX="214.0" layoutY="10.0" orientation="VERTICAL" prefHeight="0.0" prefWidth="12.0" />
            <Button fx:id="addBtn" layoutX="400.0" layoutY="11.0" mnemonicParsing="false" onAction="#onAdd" textFill="WHITE">
               <font>
                  <Font size="14.0" />
               </font>
               <tooltip>
                  <Tooltip text="%playlistmanager.playlist_table.rebuild_the_playlist_from_a_template" />
               </tooltip>
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="mdi2p-playlist-check" iconSize="18" />
               </graphic>
            </Button>
            <Button fx:id="removeBtn" mnemonicParsing="false" onAction="#onRemove" textFill="WHITE">
               <font>
                  <Font size="14.0" />
               </font>
               <tooltip>
                  <Tooltip text="%playlistmanager.playlist_table.remove_from_playlist" />
               </tooltip>
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="mdi2p-playlist-minus" iconSize="18" />
               </graphic>
            </Button>
         </items>
      </ToolBar>
   </top>
   <bottom>
      <BorderPane BorderPane.alignment="CENTER">
         <right>
            <Label fx:id="labelCount" text="%competitions.discord_competition_edit.label" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets top="3.0" />
               </BorderPane.margin></Label>
         </right>
      </BorderPane>
   </bottom>
</BorderPane>
