<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" styleClass="base-component" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.playlistmanager.PlaylistTableController">
   <top>
      <ToolBar styleClass="floating-toolbar, floating-toolbar-transparent">
         <items>
            <StackPane alignment="CENTER_RIGHT">
               <children>
                  <TextField fx:id="searchTextField" onKeyPressed="#onSearchKeyPressed" prefWidth="220.0" promptText="%cards.highscore_cards.search_table" />
                  <Button fx:id="clearBtn" mnemonicParsing="false" onAction="#onClear" styleClass="ghost-icon-button">
                     <graphic>
                        <FontIcon iconLiteral="mdi2c-close-thick" iconSize="16" styleClass="c-icon-muted" />
                     </graphic>
                  </Button>
               </children>
            </StackPane>
            <Separator fx:id="emulatorsSeparator" orientation="VERTICAL" />
            <ComboBox fx:id="allEmulatorsCombo" prefWidth="180.0" promptText="%playlistmanager.playlist_table.all_emulators" />
            <Separator orientation="VERTICAL" />
            <Button fx:id="addBtn" mnemonicParsing="false" onAction="#onAdd" styleClass="sm-button, sm-button-icon">
               <graphic>
                  <FontIcon iconLiteral="mdi2p-playlist-check" iconSize="18" styleClass="c-icon-white" />
               </graphic>
               <tooltip>
                  <Tooltip text="%playlistmanager.playlist_table.rebuild_the_playlist_from_a_template" />
               </tooltip>
            </Button>
            <Button fx:id="removeBtn" mnemonicParsing="false" onAction="#onRemove" styleClass="sm-danger-button, sm-button-icon">
               <graphic>
                  <FontIcon iconLiteral="mdi2p-playlist-minus" iconSize="18" styleClass="c-icon-danger" />
               </graphic>
               <tooltip>
                  <Tooltip text="%playlistmanager.playlist_table.remove_from_playlist" />
               </tooltip>
            </Button>
            <Pane HBox.hgrow="ALWAYS" />
            <Label fx:id="labelCount" styleClass="sm-hint" />
         </items>
      </ToolBar>
   </top>
   <center>
      <StackPane fx:id="tableStack" BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="tableView" onMouseClicked="#onTableMouseClicked">
               <columns>
                  <TableColumn fx:id="columnName" minWidth="100.0" prefWidth="380.0" text="%backups.backups.name" />
                  <TableColumn fx:id="columnEmulator" minWidth="80.0" prefWidth="200.0" sortable="false" text="%backglass.directb2s_admin.emulator" />
                  <TableColumn fx:id="columnDateAdded" minWidth="80.0" prefWidth="150.0" styleClass="sm-table-center" text="%playlistmanager.playlist_table.date_added" />
                  <TableColumn fx:id="columnDateModified" minWidth="80.0" prefWidth="150.0" styleClass="sm-table-center" text="%playlistmanager.playlist_table.last_update" />
               </columns>
            </TableView>
         </children>
      </StackPane>
   </center>
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
</BorderPane>
