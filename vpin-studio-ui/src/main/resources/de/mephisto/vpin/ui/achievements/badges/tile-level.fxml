<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" minWidth="340.0" prefWidth="380.0" spacing="8.0" styleClass="sm-tile" visible="false" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.achievements.badges.BadgesLevelTileController">
   <children>
      <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: -c-white;" text="%achievements.player_level" />
      <HBox alignment="CENTER_LEFT" spacing="14.0">
         <children>
            <StackPane fx:id="circleBox" />
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="nameLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: -c-white;" />
                  <StackPane fx:id="progressBox" />
                  <Label fx:id="nextLabel" style="-fx-font-size: 14px; -fx-text-fill: -c-muted;" />
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox>
         <children>
            <HBox spacing="10.0" style="-fx-background-color: -c-inset;">
               <children>
                  <Label minWidth="44.0" prefWidth="44.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -c-white;" text="%achievements.lvl" />
                  <Label maxWidth="Infinity" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -c-white;" text="%achievements.name" HBox.hgrow="ALWAYS" />
                  <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -c-white;" text="%achievements.from" />
               </children>
               <padding>
                  <Insets bottom="7.0" left="10.0" right="10.0" top="7.0" />
               </padding>
            </HBox>
            <VBox fx:id="levelRows" />
         </children>
      </VBox>
      <VBox spacing="6.0" style="-fx-background-color: -c-panel;">
         <children>
            <HBox spacing="8.0">
               <children>
                  <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: -c-white;" text="%achievements.prestige" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="prestigeLabel" style="-fx-font-size: 14px; -fx-text-fill: -c-warn;" />
               </children>
            </HBox>
            <Label style="-fx-font-size: 14px; -fx-text-fill: -c-muted;" text="%achievements.prestige_info" wrapText="true" />
         </children>
         <padding>
            <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
         </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
</VBox>
