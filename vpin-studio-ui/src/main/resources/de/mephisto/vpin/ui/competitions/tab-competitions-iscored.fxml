<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.competitions.IScoredSubscriptionsController">
    <center>
        <BorderPane BorderPane.alignment="CENTER">
            <center>
                <StackPane fx:id="tableStack">
                    <children>
                        <TableView fx:id="tableView" onMouseClicked="#onMouseClick" style="-fx-background-color: #2a2a2a;" styleClass="base-component">
                            <columns>
                        <TableColumn fx:id="settingsColumn" prefWidth="140.0" sortable="false" style="-fx-alignment: CENTER;" text="%competitions.competitions_iscored.game_settings" />
                        <TableColumn fx:id="tableColumn" prefWidth="350.0" style="-fx-alignment: BASELINE_LEFT;">
                           <graphic>
                              <HBox alignment="CENTER" spacing="6.0">
                                 <children>
                                    <Label text="%competitions.competitions_iscored.your_table" />
                                    <Label fx:id="publicReadAPIHint1" textFill="WHITE">
                                       <font>
                                          <Font size="14.0" />
                                       </font>
                                       <graphic>
                                          <FontIcon iconColor="WHITE" iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                                       </graphic>
                                       <tooltip>
                                          <Tooltip prefWidth="300.0" text="%competitions.competitions_iscored.only_the_first_table_match_is_shown_here" wrapText="true" />
                                       </tooltip>
                                    </Label>
                                 </children>
                              </HBox>
                           </graphic></TableColumn>
                        <TableColumn fx:id="gameRoomColumn" prefWidth="250.0" style="-fx-alignment: CENTER;" text="%competitions.competitions_iscored.game_room" />
                        <TableColumn fx:id="vpsTableColumn" minWidth="0.0" prefWidth="250.0" text="%competitions.competitions_iscored.virtual_pinball_spreadsheet_table" />
                        <TableColumn fx:id="vpsTableVersionColumn" prefWidth="400.0" sortable="false" text="%competitions.competitions_iscored.table_version" />
                        <TableColumn fx:id="creationDateColumn" prefWidth="140.0" style="-fx-alignment: CENTER;" text="%competitions.competitions_iscored.creation_date" />
                            </columns>
                        </TableView>
                    </children>
                </StackPane>
            </center>
            <top>
                <ToolBar fx:id="toolbar" prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
                    <items>
                        <Button fx:id="reloadBtn" layoutX="280.0" layoutY="12.0" mnemonicParsing="false" onAction="#onReload" textFill="WHITE">
                            <font>
                                <Font size="14.0" />
                            </font>
                            <graphic>
                                <FontIcon iconColor="WHITE" iconLiteral="mdi2r-reload" iconSize="18" />
                            </graphic>
                     <tooltip>
                        <Tooltip text="%competitions.competitions_iscored.reload_and_invalidate_game_room_caches" />
                     </tooltip>
                        </Button>
                  <Separator layoutX="264.0" layoutY="10.0" orientation="VERTICAL" prefHeight="0.0" prefWidth="12.0" />
                  <StackPane alignment="CENTER_RIGHT">
                     <children>
                              <TextField fx:id="textfieldSearch" prefWidth="160.0" promptText="%competitions.competitions_iscored.subscription_search">
                                  <font>
                                      <Font size="14.0" />
                                  </font>
                              </TextField>
                        <Button fx:id="clearBtn" mnemonicParsing="false" onAction="#onClear" styleClass="ghost-icon-button" textFill="WHITE">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <graphic>
                              <FontIcon iconColor="#222222" iconLiteral="mdi2c-close-thick" iconSize="18" />
                           </graphic>
                        </Button>
                     </children>
                  </StackPane>
                        <Separator orientation="VERTICAL" prefHeight="0.0" prefWidth="12.0" />
                  <ComboBox fx:id="gameRoomsCombo" prefWidth="260.0" />
                  <Button fx:id="syncBtn" layoutX="10.0" layoutY="11.0" mnemonicParsing="false" onAction="#onSync" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2s-sync" iconSize="18" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%competitions.competitions_iscored.synchronize_the_iscored_game_room_games_with_the" />
                     </tooltip>
                  </Button>
                  <Button fx:id="editBtn" layoutX="640.0" layoutY="11.0" mnemonicParsing="false" onAction="#onEdit" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2f-file-document-edit-outline" iconSize="18" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%competitions.competitions_iscored.edit_game_room_settings" />
                     </tooltip>
                  </Button>
                  <Button layoutX="288.0" layoutY="11.0" mnemonicParsing="false" onAction="#onGameRooms" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2c-cog" iconSize="18" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%competitions.competitions_iscored.open_game_room_preferences" />
                     </tooltip>
                  </Button>
                  <Separator fx:id="playBtnSeparator" layoutX="809.0" layoutY="10.0" orientation="VERTICAL" prefHeight="0.0" prefWidth="12.0" />
                  <Button fx:id="stopBtn" mnemonicParsing="false" onAction="#onStop" textFill="#ff3333">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconColor="#ff3333" iconLiteral="mdi2s-stop" iconSize="18" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%competitions.competitions_iscored.kill_all_emulator_and_frontend_processes_ctrl_k" />
                     </tooltip>
                  </Button>
                  <Separator layoutX="272.0" layoutY="10.0" orientation="VERTICAL" prefHeight="0.0" prefWidth="12.0" />
                        <Button fx:id="addBtn" layoutX="280.0" layoutY="11.0" mnemonicParsing="false" onAction="#onCompetitionCreate" textFill="WHITE">
                            <font>
                                <Font size="14.0" />
                            </font>
                            <graphic>
                                <FontIcon iconColor="WHITE" iconLiteral="mdi2p-plus-circle-outline" iconSize="18" />
                            </graphic>
                     <tooltip>
                        <Tooltip text="%competitions.competitions_iscored.create_a_new_competition_for_the_selected_game" />
                     </tooltip>
                        </Button>
                        <Button fx:id="deleteBtn" layoutX="464.0" layoutY="11.0" mnemonicParsing="false" onAction="#onDelete" textFill="#ff3333">
                            <font>
                                <Font size="14.0" />
                            </font>
                            <graphic>
                                <FontIcon iconColor="#ff3333" iconLiteral="mdi2d-delete-outline" iconSize="18" />
                            </graphic>
                     <tooltip>
                        <Tooltip text="%competitions.competitions_iscored.delete_the_selected_competition_note_that_it_might" />
                     </tooltip>
                        </Button>
                  <Separator layoutX="867.0" layoutY="10.0" orientation="VERTICAL" prefHeight="0.0" prefWidth="12.0" />
                  <Button fx:id="dataManagerBtn" mnemonicParsing="false" onAction="#onTableDataManager" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2l-lead-pencil" iconSize="18" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%backglass.directb2s_sidebar.edit_table_data" />
                     </tooltip>
                  </Button>
                  <Button fx:id="tableNavigateBtn" mnemonicParsing="false" onAction="#onOpenTable" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2t-table-edit" iconSize="18" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%backglass.directb2s_sidebar.show_table_in_table_overview" />
                     </tooltip>
                  </Button>
                  <Separator layoutX="946.0" layoutY="10.0" orientation="VERTICAL" prefHeight="0.0" prefWidth="12.0" />
                  <Button fx:id="eventLogBtn" layoutX="1004.0" layoutY="11.0" mnemonicParsing="false" onAction="#onEventLog" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2m-message-text-clock-outline" iconSize="18" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%competitions.competitions_iscored.open_event_log" />
                     </tooltip>
                  </Button>
                    </items>
                </ToolBar>
            </top>
            <bottom>
                <BorderPane BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets bottom="6.0" />
                    </BorderPane.margin>
                </BorderPane>
            </bottom>
        </BorderPane>
    </center>
    <BorderPane.margin>
        <Insets right="12.0" />
    </BorderPane.margin>
    <top>
        <BorderPane fx:id="competitionWidget" BorderPane.alignment="CENTER" />
    </top>
</BorderPane>
