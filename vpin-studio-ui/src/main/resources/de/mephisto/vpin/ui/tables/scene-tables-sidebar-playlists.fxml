<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane fx:id="defaultBackgroundBorderPane" prefWidth="600.0" styleClass="base-component" stylesheets="@../stylesheet.css" BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.tables.TablesSidebarPlaylistsController">
   <padding>
      <Insets left="1.0" right="1.0" />
   </padding>
   <center>
      <VBox fx:id="parentBox" BorderPane.alignment="TOP_LEFT">
         <children>
            <VBox fx:id="errorBox" styleClass="sm-alert">
               <children>
                  <HBox spacing="12.0">
                     <children>
                        <StackPane maxHeight="24.0" maxWidth="24.0" minHeight="24.0" minWidth="24.0" styleClass="sm-alert-icon">
                           <children>
                              <FontIcon iconColor="WHITE" iconLiteral="mdi2e-exclamation-thick" iconSize="14" />
                           </children>
                        </StackPane>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="errorTitle" maxWidth="1.7976931348623157E308" styleClass="sm-alert-title" wrapText="true" />
                              <Label fx:id="errorText" styleClass="sm-alert-text" wrapText="true" />
                           </children>
                        </VBox>
                        <HBox alignment="TOP_RIGHT" spacing="6.0">
                           <children>
                              <Button fx:id="dismissLink" mnemonicParsing="false" onAction="#onDismiss" styleClass="sm-alert-close">
                                 <graphic>
                                    <FontIcon iconColor="#E6C3C5" iconLiteral="mdi2c-close" iconSize="16" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%backglass.directb2s_admin.dismiss" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
               </padding>
               <VBox.margin>
                  <Insets bottom="12.0" left="0.0" right="0.0" top="0.0" />
               </VBox.margin>
            </VBox>
            <VBox fx:id="emptyDataBox">
               <children>
                  <Label fx:id="emptyDataLabel" styleClass="preference-description" text="%tables.tables_sidebar_mame.no_table_selected" />
               </children>
               <VBox.margin>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </VBox.margin>
            </VBox>
            <VBox fx:id="dataRoot">
               <children>
                  <Label fx:id="dialogTitleLabel" styleClass="default-title" text="%tables.table_asset_manager.playlists" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="dialogCommentLabel" text="%tables.tables_sidebar_playlists.changes_in_this_tab_will_be_stored_immediately" wrapText="true">
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2a-alert-rhombus-outline" iconSize="18" />
                     </graphic>
                     <VBox.margin>
                        <Insets top="6.0" />
                     </VBox.margin>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </VBox.margin>
            </VBox>
            <ScrollPane hbarPolicy="NEVER">
               <content>
                    <VBox fx:id="dataBox" spacing="1.0" />
               </content>
               <VBox.margin>
                  <Insets bottom="12.0" left="12.0" top="12.0" />
               </VBox.margin>
            </ScrollPane>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </center>
   <top>
      <ToolBar fx:id="toolbar" prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="playlistManagerBtn" layoutX="26.0" layoutY="11.0" mnemonicParsing="false" onAction="#onPlaylistManager" text="%tables.tables_sidebar_playlists.playlist_manager" textFill="WHITE">
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="mdi2p-playlist-edit" iconSize="18" />
               </graphic>
               <font>
                  <Font size="14.0" />
               </font>
               <tooltip>
                  <Tooltip text="%tables.tables_sidebar_playlists.edit_playlist_assets" />
               </tooltip>
            </Button>
            <Separator fx:id="playlistManagerSeparator" orientation="VERTICAL" prefHeight="0.0" prefWidth="12.0" />
            <Button fx:id="assetManagerBtn" mnemonicParsing="false" onAction="#onMediaEdit" text="%tables.tables_sidebar_playlists.edit_playlist_assets" textFill="WHITE">
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="mdi2m-movie-edit-outline" iconSize="18" />
               </graphic>
               <font>
                  <Font size="14.0" />
               </font>
               <tooltip>
                  <Tooltip text="%tables.tables_sidebar_playlists.edit_playlist_assets" />
               </tooltip>
            </Button>
         </items>
      </ToolBar>
   </top>
</BorderPane>
