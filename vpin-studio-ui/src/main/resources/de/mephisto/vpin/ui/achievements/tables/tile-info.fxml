<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" style="-fx-background-color: #2A2A2A; -fx-background-radius: 6;" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.achievements.tables.TableInfoTileController">
   <children>
      <Label fx:id="titleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />
      <Label fx:id="textLabel" style="-fx-font-size: 14px; -fx-text-fill: #BDBDBD;" />
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
</VBox>
