                     </graphic>
                     <tooltip>
                        <Tooltip text="%bulk_importer.size_small" />
                     </tooltip>
                  </ToggleButton>
                  <ToggleButton fx:id="sizeMediumBtn" mnemonicParsing="false" selected="true" toggleGroup="$previewSizeGroup">
