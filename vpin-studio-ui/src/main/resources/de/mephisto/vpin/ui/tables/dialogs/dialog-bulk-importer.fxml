            </ToolBar>
            <TableView fx:id="tableView" minHeight="120.0" style="-fx-background-color: #2a2a2a;" styleClass="base-component" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="columnSelect" maxWidth="44.0" minWidth="44.0" prefWidth="44.0" resizable="false" sortable="false" style="-fx-alignment: CENTER;" />
         <TableColumn fx:id="columnPreview" prefWidth="120.0" resizable="false" sortable="false" style="-fx-alignment: CENTER;" text="%bulk_importer.column_preview" />
         <TableColumn fx:id="columnFile" prefWidth="330.0" style="-fx-alignment: CENTER_LEFT;" text="%bulk_importer.column_file" />
         <TableColumn fx:id="columnTable" prefWidth="420.0" sortable="false" style="-fx-alignment: CENTER_LEFT;" text="%bulk_importer.column_table" />
         <TableColumn fx:id="columnScore" prefWidth="120.0" style="-fx-alignment: CENTER_LEFT;" text="%bulk_importer.column_match" />
         <TableColumn fx:id="columnScreen" prefWidth="150.0" sortable="false" style="-fx-alignment: CENTER_LEFT;" text="%bulk_importer.column_screen" />
         <TableColumn fx:id="columnMode" prefWidth="150.0" sortable="false" style="-fx-alignment: CENTER_LEFT;" text="%bulk_importer.column_mode" />
      </columns>
   </TableView>
         </children>
