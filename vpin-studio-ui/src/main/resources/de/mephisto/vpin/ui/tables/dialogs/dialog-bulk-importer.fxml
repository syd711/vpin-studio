                                       <tooltip>
                                          <Tooltip prefWidth="300.0" text="%bulk_importer.move_flat_tooltip" wrapText="true" />
                                       </tooltip>
                                    </RadioButton>
                                    <RadioButton fx:id="moveKeepStructureRadio" mnemonicParsing="false" styleClass="default-text" text="%bulk_importer.move_keep_structure" toggleGroup="$moveStructureGroup">
                                       <tooltip>
                                          <Tooltip prefWidth="300.0" text="%bulk_importer.move_keep_structure_tooltip" wrapText="true" />
                                       </tooltip>
                                    </RadioButton>
                                 </children>
                              </HBox>
