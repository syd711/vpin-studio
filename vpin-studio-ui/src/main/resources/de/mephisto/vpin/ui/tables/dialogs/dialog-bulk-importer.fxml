               </HBox.margin>
            </Button>
            <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#onCancelClick" styleClass="default-button" text="%backglass.res_generator.cancel" />
            <Button fx:id="importBtn" disable="true" mnemonicParsing="false" onAction="#onImport" styleClass="submit-button" text="%bulk_importer.import" />
         </children>
         <BorderPane.margin>
            <Insets bottom="12.0" left="12.0" right="12.0" top="6.0" />
         </BorderPane.margin>
      </HBox>
