                     <tooltip>
                        <Tooltip text="%bulk_importer.size_medium" />
                     </tooltip>
                  </ToggleButton>
                  <ToggleButton fx:id="sizeLargeBtn" mnemonicParsing="false" selected="false" toggleGroup="$previewSizeGroup">
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2i-image-size-select-actual" iconSize="18" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%bulk_importer.size_large" />
                     </tooltip>
                  </ToggleButton>
