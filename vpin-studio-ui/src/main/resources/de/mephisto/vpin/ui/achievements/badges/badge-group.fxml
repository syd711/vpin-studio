   <children>
      <Label fx:id="titleLabel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -c-muted;" />
      <GridPane fx:id="grid" hgap="6.0" vgap="6.0">
         <columnConstraints>
            <ColumnConstraints percentWidth="25.0" />
            <ColumnConstraints percentWidth="25.0" />
            <ColumnConstraints percentWidth="25.0" />
            <ColumnConstraints percentWidth="25.0" />
