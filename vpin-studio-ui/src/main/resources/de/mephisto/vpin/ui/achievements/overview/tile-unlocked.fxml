<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="Infinity" spacing="8.0" styleClass="sm-tile" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.achievements.overview.OverviewUnlockedTileController">
   <children>
      <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: -c-white;" text="%achievements.unlocked" />
      <Label fx:id="countLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: -c-white; -fx-font-family: 'Monospaced';" />
      <Label fx:id="weekLabel" style="-fx-font-size: 14px; -fx-text-fill: -c-ok;" />
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
</VBox>
