<?import javafx.scene.layout.Pane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- common collapsible panels (UI-STYLEGUIDE.md, "Collapsible panels"), header widths are bound in TablesSidebarController -->
<BorderPane maxWidth="620.0" prefWidth="620.0" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.mephisto.vpin.ui.tables.TablesSidebarController">
   <center>
      <Accordion fx:id="tableAccordion" maxHeight="-Infinity" BorderPane.alignment="CENTER">
         <panes>
            <TitledPane fx:id="titledPaneMedia" maxHeight="1.7976931348623157E308" prefHeight="1100.0">
               <graphic>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <FontIcon iconLiteral="mdi2i-image-multiple-outline" iconSize="18" styleClass="c-icon-muted" />
                        <Label styleClass="sm-collapsible-title" text="%tables.tables_sidebar.table_media" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <CheckBox fx:id="mediaPreviewCheckbox" mnemonicParsing="false" selected="true" styleClass="c-text-white" text="%backglass.res_generator.preview" />
                        <HBox fx:id="frontendTitleButtonArea" alignment="CENTER_RIGHT" spacing="6.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onPrefsScreenValidators" styleClass="sm-collapsible-button">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2c-cog" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%tables.tables_sidebar.open_screen_validators_settings" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </graphic>
            </TitledPane>
            <TitledPane fx:id="titledPaneTableData" expanded="false">
               <graphic>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <FontIcon iconLiteral="mdi2f-file-document-outline" iconSize="18" styleClass="c-icon-muted" />
                        <Label styleClass="sm-collapsible-title" text="%pref.restore_backup.table_data" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_RIGHT" spacing="6.0">
                           <children>
                              <Button fx:id="tablesBtn" mnemonicParsing="false" onAction="#onTables" styleClass="sm-collapsible-button, folder-component">
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2f-folder-open" styleClass="c-icon-white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%dropins.dropin_container.open_folder" />
