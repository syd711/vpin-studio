                           </font>
                        </Label>
                        <Label layoutX="10.0" layoutY="45.0" text="%tables.tables_sidebar_altsound.bundle_size_unpacked" styleClass="c-text-white" GridPane.rowIndex="4">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="entriesLabel" layoutX="10.0" layoutY="15.0" text="-" styleClass="c-text-white" GridPane.columnIndex="1" GridPane.rowIndex="2">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="filesLabel" layoutX="175.0" layoutY="15.0" text="-" styleClass="c-text-white" GridPane.columnIndex="1" GridPane.rowIndex="3">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="bundleSizeLabel" layoutX="175.0" layoutY="45.0" text="-" styleClass="c-text-white" GridPane.columnIndex="1" GridPane.rowIndex="4">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label layoutX="10.0" layoutY="45.0" text="%backups.backups_sidebar.last_modified" styleClass="c-text-white" GridPane.rowIndex="5">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label layoutX="10.0" layoutY="45.0" text="%tables.tables_sidebar_altsound.format" styleClass="c-text-white" GridPane.rowIndex="1">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="formatLabel" layoutX="175.0" layoutY="45.0" text="-" styleClass="c-text-white" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label layoutX="10.0" layoutY="45.0" text="%backglass.directb2s_sidebar.name" styleClass="c-text-white">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="nameLabel" layoutX="175.0" layoutY="45.0" text="-" styleClass="c-text-white" GridPane.columnIndex="1">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                     </children>
                     <VBox.margin>
                        <Insets top="6.0" />
                     </VBox.margin>
                  </GridPane>
                  </children>
               <VBox.margin>
