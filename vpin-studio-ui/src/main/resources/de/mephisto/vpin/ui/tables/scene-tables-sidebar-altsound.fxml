                     </VBox.margin></Label>
                  <Label layoutX="10.0" layoutY="42.0" prefWidth="550.0" styleClass="preference-description" text="%tables.tables_sidebar_altcolor.upload_downloaded_resources_here" wrapText="true" />
               </children>
