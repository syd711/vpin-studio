               </VBox.margin>
            </VBox>
         </children>
      </VBox>
    </center>
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <ToolBar prefHeight="40.0" prefWidth="200.0">
              <items>
                  <Button fx:id="uploadBtn" layoutX="145.0" layoutY="11.0" mnemonicParsing="false" onAction="#onUpload" text="%backups.backup_upload.upload" styleClass="c-text-white">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon styleClass="c-icon-white" iconLiteral="mdi2u-upload" iconSize="18" />
                     </graphic>
                  </Button>
                  <Button fx:id="rom2AltSoundBtn" mnemonicParsing="false" onAction="#onRom2AltSound" text="%tables.tables_sidebar_altsound.create_from_rom" styleClass="c-text-white">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon styleClass="c-icon-white" iconLiteral="mdi2m-music-box-multiple-outline" iconSize="18" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="%tables.tables_sidebar_altsound.create_from_rom_tooltip" />
                     </tooltip>
                  </Button>
                  <Separator orientation="VERTICAL" prefWidth="12.0" />
                  <Button fx:id="reloadBtn" mnemonicParsing="false" onAction="#onReload" text="%competitions.competitions.reload">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon styleClass="c-icon-white" iconLiteral="mdi2r-reload" iconSize="18" />
                     </graphic>
                  </Button>
                  <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#onDelete" text="%backups.backups.delete" styleClass="c-text-danger">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon styleClass="c-icon-danger" iconLiteral="mdi2d-delete-outline" iconSize="18" />
                     </graphic>
                  </Button>
              </items>
            </ToolBar>
            <ToolBar prefHeight="40.0" prefWidth="200.0">
               <items>
                <Button fx:id="altSoundBtn" mnemonicParsing="false" onAction="#onAltSoundEdit" text="%competitions.competitions_discord.edit" styleClass="c-text-white">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon styleClass="c-icon-white" iconLiteral="mdi2l-lead-pencil" iconSize="18" />
                     </graphic>
                  </Button>
                  <Button fx:id="restoreBtn" mnemonicParsing="false" onAction="#onRestore" text="%backups.backup_restore.restore" styleClass="c-text-white">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon styleClass="c-icon-white" iconLiteral="mdi2u-undo" iconSize="18" />
                     </graphic>
                  </Button>
               </items>
            </ToolBar>
         </children>
      </VBox>
   </top>
   <padding>
      <Insets left="1.0" right="1.0" />
   </padding>
</BorderPane>
