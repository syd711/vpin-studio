<BorderPane fx:id="altSoundRoot" prefWidth="600.0" styleClass="base-component" stylesheets="@../stylesheet.css" BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.mephisto.vpin.ui.tables.TablesSidebarAltSoundController">
    <center>
      <VBox fx:id="dataRoot" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <children>
            <VBox fx:id="errorBox" styleClass="sm-alert">
               <children>
                  <HBox spacing="12.0">
                     <children>
                        <StackPane maxHeight="24.0" maxWidth="24.0" minHeight="24.0" minWidth="24.0" styleClass="sm-alert-icon">
                           <children>
                              <FontIcon styleClass="c-icon-white" iconLiteral="mdi2e-exclamation-thick" iconSize="14" />
                           </children>
                        </StackPane>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="errorTitle" maxWidth="1.7976931348623157E308" styleClass="sm-alert-title" wrapText="true" />
                              <Label fx:id="errorText" styleClass="sm-alert-text" wrapText="true" />
                           </children>
                        </VBox>
                        <HBox alignment="TOP_RIGHT" spacing="6.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#onDismiss" styleClass="sm-alert-close">
                                 <graphic>
                                    <FontIcon styleClass="c-icon-error-text" iconLiteral="mdi2c-close" iconSize="16" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="%backglass.directb2s_admin.dismiss" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
               </padding>
               <VBox.margin>
                  <Insets bottom="12.0" left="0.0" right="0.0" top="0.0" />
               </VBox.margin>
            </VBox>
              <VBox fx:id="dataBox">
                  <children>
                  <Label text="%tables.tables_sidebar_altsound.alt_sound_data" styleClass="c-text-white">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <GridPane>
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="282.199951171875" minWidth="10.0" prefWidth="164.000048828125" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="410.399951171875" minWidth="10.0" prefWidth="410.399951171875" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label fx:id="lastModifiedLabel" layoutX="175.0" layoutY="76.0" text="-" styleClass="c-text-white" GridPane.columnIndex="1" GridPane.rowIndex="5">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label text="%tables.tables_sidebar_altsound.csv_entries" styleClass="c-text-white" GridPane.rowIndex="2">
                           <font>
                              <Font size="14.0" />
